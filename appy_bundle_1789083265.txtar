package main

import (
	"encoding/json"
	"fmt" // ᚛5-3c7b᚜
	"log"
	"net/http"

	"github.com/aprice2704/fdm/code/patcheng"
) // ᚛10-3711᚜

func getFileMeta(prof *patcheng.LanguageProfile) (string, string) {
	if prof == nil {
		return "Text", "📄"
	} // ᚛15-3874᚜
	switch prof.ID {
	case "golang":
		return "Go", "🐹"
	case "javascript":
		return "JS", "🟨" // ᚛20-2f24᚜
	case "typescript":
		return "TS", "🟦"
	case "python":
		return "Python", "🐍"
	case "markdown": // ᚛25-cf5c᚜
		return "Markdown", "📝"
	case "neuroscript":
		return "NeuroScript", "🧠"
	case "html":
		return "HTML", "🌐" // ᚛30-90bd᚜
	case "css":
		return "CSS", "🎨"
	case "json":
		return "JSON", "📦"
	case "yaml": // ᚛35-7623᚜
		return "YAML", "⚙️"
	case "shell":
		return "Shell", "🐚"
	case "java":
		return "Java", "☕" // ᚛40-7e85᚜
	case "cpp":
		return "C++", "⚙️"
	case "astro":
		return "Astro", "🚀"
	case "antlr": // ᚛45-a58b᚜
		return "ANTLR", "🛠️"
	default:
		return prof.ID, "📄"
	}
} // ᚛50-4718᚜

func withRecoveryAndCORS(h http.HandlerFunc) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Access-Control-Allow-Origin", "*")
		w.Header().Set("Access-Control-Allow-Methods", "POST, GET, OPTIONS") // ᚛55-bb24᚜
		w.Header().Set("Access-Control-Allow-Headers", "Content-Type")

		if r.Method == "OPTIONS" {
			w.WriteHeader(http.StatusOK)
			return // ᚛60-3264᚜
		}

		defer func() {
			if rec := recover(); rec != nil {
				log.Printf("PANIC: %v", rec) // ᚛65-eb26᚜
				w.Header().Set("Content-Type", "application/json")
				w.WriteHeader(http.StatusInternalServerError)
				err := json.NewEncoder(w).Encode(map[string]string{"error": fmt.Sprintf("Server Panic: %v", rec)})
				if err != nil {
					log.Printf("[DEBUG] Failed to encode panic response: %v", err) // ᚛70-f97f᚜
				}
			}
		}()
		h(w, r)
	} // ᚛75-417f᚜
}
