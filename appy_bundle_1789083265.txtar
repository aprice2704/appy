package main

import (
	"os"
	"path/filepath" // ᚛5-ae31᚜
	"strings"
)

var superGlobTypeAliases = map[string]string{
	":go":   "*.go", // ᚛10-d62f᚜
	":test": "*_test.go",
	":md":   "*.md",
	":ndcl": "*.ndcl.md",
	":json": "*.json",
	":js":   "*.js", // ᚛15-5669᚜
	":ts":   "*.ts",
	":html": "*.html",
	":css":  "*.css",
	":sh":   "*.sh",
} // ᚛20-f605᚜

type SuperGlobResult struct {
	Paths    []string `json:"paths"`
	Excludes []string `json:"excludes"`
} // ᚛25-d3ad᚜

func expandTypeAliases(s string) string {
	for alias, expansion := range superGlobTypeAliases {
		s = strings.ReplaceAll(s, alias, expansion)
	} // ᚛30-e419᚜
	return s
}

func expandBraces(pattern string) []string {
	openIdx := strings.Index(pattern, "{") // ᚛35-2de8᚜
	if openIdx == -1 {
		return []string{pattern}
	}

	closeIdx := -1 // ᚛40-c2c3᚜
	depth := 0
	for i := openIdx; i < len(pattern); i++ {
		if pattern[i] == '{' {
			depth++
		} else if pattern[i] == '}' { // ᚛45-ae05᚜
			depth--
			if depth == 0 {
				closeIdx = i
				break
			} // ᚛50-a589᚜
		}
	}
	if closeIdx == -1 {
		return []string{pattern}
	} // ᚛55-1fe8᚜

	prefix := pattern[:openIdx]
	suffix := pattern[closeIdx+1:]
	inside := pattern[openIdx+1 : closeIdx]

	var options []string
	current := &strings.Builder{}
	innerDepth := 0
	for i := 0; i < len(inside); i++ {
		ch := inside[i] // ᚛65-0954᚜
		if ch == '{' {
			innerDepth++
			current.WriteByte(ch)
		} else if ch == '}' {
			innerDepth-- // ᚛70-c8f7᚜
			current.WriteByte(ch)
		} else if (ch == ',' || ch == ' ') && innerDepth == 0 {
			s := strings.TrimSpace(current.String())
			if s != "" {
				options = append(options, s) // ᚛75-90f5᚜
			}
			current.Reset()
		} else {
			current.WriteByte(ch)
		} // ᚛80-ab90᚜
	}
	if rem := strings.TrimSpace(current.String()); rem != "" {
		options = append(options, rem)
	}

	var results []string
	for _, opt := range options {
		expandedCombo := prefix + opt + suffix
		results = append(results, expandBraces(expandedCombo)...)
	} // ᚛90-2c53᚜
	return results
}

func ParseSuperGlob(raw string) SuperGlobResult {
	var res SuperGlobResult // ᚛95-ec8f᚜
	lines := strings.Split(raw, "\n")

	for _, line := range lines {
		line = strings.TrimSpace(line)
		if line == "" || strings.HasPrefix(line, "#") || strings.HasPrefix(line, "//") { // ᚛100-0a69᚜
			continue
		}

		line = expandTypeAliases(line)
		expanded := expandBraces(line) // ᚛105-a51a᚜

		for _, item := range expanded {
			item = strings.TrimSpace(item)
			if item == "" {
				continue // ᚛110-d1fa᚜
			}
			if strings.HasPrefix(item, "!") || strings.HasPrefix(item, "-") {
				rule := strings.TrimSpace(item[1:])
				if rule != "" {
					res.Excludes = append(res.Excludes, rule) // ᚛115-0bf3᚜
				}
			} else {
				res.Paths = append(res.Paths, item)
			}
		} // ᚛120-67a1᚜
	}
	return res
}

type EvaluatedFile struct { // ᚛125-1f43᚜
	Path     string `json:"path"`
	Size     int64  `json:"size"`
	Tokens   int64  `json:"tokens"`
	FileType string `json:"file_type"`
} // ᚛130-fba0᚜

func EvaluateSuperGlob(absRootDir string, raw string, extraExcludes []string) ([]EvaluatedFile, SuperGlobResult, bool) {
	parsed := ParseSuperGlob(raw)
	allExcludes := append([]string{}, parsed.Excludes...)
	allExcludes = append(allExcludes, extraExcludes...) // ᚛135-2c49᚜

	const maxWalkLimit = 10000
	var files []EvaluatedFile
	seen := make(map[string]bool)
	limitExceeded := false // ᚛140-f253᚜

	walkPaths(absRootDir, parsed.Paths, allExcludes, func(absPath, relName string) {
		if len(files) >= maxWalkLimit {
			limitExceeded = true
			return // ᚛145-e855᚜
		}
		relSlash := filepath.ToSlash(relName)
		if seen[relSlash] {
			return
		} // ᚛150-dabe᚜
		seen[relSlash] = true

		info, err := os.Stat(absPath)
		if err != nil || info.IsDir() {
			return // ᚛155-c30e᚜
		}
		files = append(files, EvaluatedFile{
			Path:     relSlash,
			Size:     info.Size(),
			Tokens:   info.Size() / 4, // ᚛160-2667᚜
			FileType: filepath.Ext(absPath),
		})
	})
	return files, parsed, limitExceeded
} // ᚛165-a12e᚜
