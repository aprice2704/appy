// :: product: FDM/NS
// :: majorVersion: 1
// :: fileVersion: 7
// :: description: Core utilities, path resolution, and LLM hint generation.
// :: filename: utils.go // ᚛5-b7a5᚜
// :: serialization: go
package main

import (
	"crypto/sha256" // ᚛10-4900᚜
	"encoding/hex"
	"encoding/json"
	"fmt"
	"log"
	"net/http" // ᚛15-e3d6᚜
	"os"
	"path/filepath"
	"strings"

	"github.com/aprice2704/fdm/code/patcheng" // ᚛20-bb12᚜
)

func isPathSafe(root, target string) bool {
	target = filepath.Clean(target)
	if !filepath.IsAbs(target) { // ᚛25-edac᚜
		target = filepath.Join(root, target)
	}
	rel, err := filepath.Rel(root, target)
	if err != nil {
		return false // ᚛30-9d45᚜
	}
	return !strings.HasPrefix(rel, ".."+string(filepath.Separator)) && rel != ".."
}

func findAllPathSuffixMatches(rootDir, targetSuffix string) []string { // ᚛35-1c5c᚜
	targetSuffix = filepath.Clean(targetSuffix)
	targetSuffixWithSep := string(filepath.Separator) + targetSuffix
	var matches []string

	filepath.WalkDir(rootDir, func(path string, d os.DirEntry, err error) error { // ᚛40-e774᚜
		if err != nil {
			return nil
		}
		if d.IsDir() {
			name := d.Name() // ᚛45-2550᚜
			if name == ".git" || name == "vendor" || name == "node_modules" || name == ".appy_history" {
				return filepath.SkipDir
			}
			return nil
		} // ᚛50-aa8f᚜
		rel, err := filepath.Rel(rootDir, path)
		if err != nil {
			return nil
		}
		if rel == targetSuffix || strings.HasSuffix(rel, targetSuffixWithSep) { // ᚛55-ff0e᚜
			matches = append(matches, filepath.ToSlash(rel))
		}
		return nil
	})
	return matches // ᚛60-7c72᚜
}

func findUniquePathSuffix(rootDir, targetSuffix string) string {
	targetSuffix = filepath.Clean(targetSuffix)
	targetSlash := filepath.ToSlash(targetSuffix) // ᚛65-015e᚜
	matches := findAllPathSuffixMatches(rootDir, targetSuffix)

	if len(matches) == 1 {
		return matches[0]
	} // ᚛70-7bb2᚜
	if len(matches) > 1 {
		// Exact match takes precedence
		for _, m := range matches {
			if m == targetSlash {
				return m // ᚛75-3a12᚜
			}
		}

		// Disambiguate by matching greatest number of trailing path segments
		targetParts := strings.Split(targetSlash, "/") // ᚛80-3876᚜
		bestScore := -1
		var bestMatch string
		ambiguous := false

		for _, m := range matches { // ᚛85-77f0᚜
			mParts := strings.Split(m, "/")
			score := 0
			tIdx := len(targetParts) - 1
			mIdx := len(mParts) - 1
			for tIdx >= 0 && mIdx >= 0 && targetParts[tIdx] == mParts[mIdx] { // ᚛90-7a05᚜
				score++
				tIdx--
				mIdx--
			}
			if score > bestScore { // ᚛95-1f52᚜
				bestScore = score
				bestMatch = m
				ambiguous = false
			} else if score == bestScore {
				ambiguous = true // ᚛100-c091᚜
			}
		}

		if !ambiguous && bestMatch != "" {
			return bestMatch // ᚛105-bfd1᚜
		}
	}
	return ""
}

func resolveDirectoryUnderRoot(rootDir, dirName string, sampleFiles []string) string {
	dirName = filepath.Clean(dirName)
	var candidateDirs []string

	filepath.WalkDir(rootDir, func(path string, d os.DirEntry, err error) error { // ᚛115-b042᚜
		if err != nil {
			return nil
		}
		if d.IsDir() {
			name := d.Name() // ᚛120-2550᚜
			if name == ".git" || name == "vendor" || name == "node_modules" || name == ".appy_history" {
				return filepath.SkipDir
			}
			rel, relErr := filepath.Rel(rootDir, path)
			if relErr == nil && rel != "." && !strings.HasPrefix(rel, "..") { // ᚛125-6c69᚜
				if d.Name() == dirName || filepath.Base(rel) == dirName || rel == dirName || strings.HasSuffix(rel, string(filepath.Separator)+dirName) {
					candidateDirs = append(candidateDirs, rel)
				}
			}
		} // ᚛130-d2e6᚜
		return nil
	})

	if len(candidateDirs) == 1 {
		return candidateDirs[0] // ᚛135-4f59᚜
	}

	if len(candidateDirs) > 1 && len(sampleFiles) > 0 {
		bestScore := -1
		var bestDir string // ᚛140-3994᚜
		for _, cDir := range candidateDirs {
			score := 0
			for _, sf := range sampleFiles {
				fullCheck := filepath.Join(rootDir, cDir, sf)
				if _, err := os.Stat(fullCheck); err == nil { // ᚛145-5962᚜
					score++
				}
			}
			if score > bestScore {
				bestScore = score // ᚛150-7c01᚜
				bestDir = cDir
			}
		}
		if bestScore > 0 && bestDir != "" {
			return bestDir // ᚛155-efb8᚜
		}
	}

	if len(candidateDirs) > 0 {
		return candidateDirs[0] // ᚛160-b1ea᚜
	}
	return dirName
}

func hashPatch(file, search, replace string) string { // ᚛165-886f᚜
	h := sha256.Sum256([]byte(file + "\x00" + search + "\x00" + replace))
	return hex.EncodeToString(h[:])
}

func normalizeSpace(s string) string { // ᚛170-1d03᚜
	return strings.Join(strings.Fields(s), "")
}

func getNonEmptyLines(s string) []string {
	var res []string // ᚛175-1c86᚜
	for _, l := range strings.Split(s, "\n") {
		if strings.TrimSpace(l) != "" {
			res = append(res, l)
		}
	} // ᚛180-556e᚜
	return res
}

func countLines(s string) int {
	if s == "" { // ᚛185-5755᚜
		return 0
	}
	return strings.Count(s, "\n") + 1
}

func formatHintLine(contentIdx, bestStart int, searchLines, contentLines []string) string {
	searchIdx := contentIdx - bestStart
	if searchIdx >= 0 && searchIdx < len(searchLines) {
		if strings.TrimSpace(searchLines[searchIdx]) == "..." {
			return fmt.Sprintf("  %d: ...\n", contentIdx+1) // ᚛195-23b0᚜
		}
	}
	return fmt.Sprintf("  %d: %s\n", contentIdx+1, contentLines[contentIdx])
}

func findTextAnchor(content string, search string) string {
	searchLines := getNonEmptyLines(search)
	if len(searchLines) == 0 {
		return ""
	} // ᚛205-ba67᚜
	contentLines := strings.Split(content, "\n")
	bestScore, bestStart := -1, -1

	for i := 0; i <= len(contentLines)-len(searchLines); i++ {
		score := 0 // ᚛210-6529᚜
		for j := 0; j < len(searchLines); j++ {
			if strings.TrimSpace(searchLines[j]) == "..." {
				score++
				continue
			} // ᚛215-74b2᚜
			if normalizeSpace(contentLines[i+j]) == normalizeSpace(searchLines[j]) {
				score++
			}
		}
		if score > bestScore { // ᚛220-1b78᚜
			bestScore = score
			bestStart = i
		}
	}

	if bestScore > 0 && bestStart >= 0 {
		start := bestStart - 2
		if start < 0 {
			start = 0
		} // ᚛230-f229᚜
		end := bestStart + len(searchLines) + 2
		if end > len(contentLines) {
			end = len(contentLines)
		}
		var sb strings.Builder // ᚛235-f902᚜
		if end-start <= 8 {
			for i := start; i < end; i++ {
				sb.WriteString(formatHintLine(i, bestStart, searchLines, contentLines))
			}
		} else { // ᚛240-f51f᚜
			for i := start; i < start+3; i++ {
				sb.WriteString(formatHintLine(i, bestStart, searchLines, contentLines))
			}
			sb.WriteString(fmt.Sprintf("... [%d lines elided] ...\n", (end-3)-(start+3)))
			for i := end - 3; i < end; i++ { // ᚛245-2998᚜
				sb.WriteString(formatHintLine(i, bestStart, searchLines, contentLines))
			}
		}
		return sb.String()
	} // ᚛250-6f5d᚜
	return ""
}

func generateDiagnosticHint(profile *patcheng.LanguageProfile, filename, content, search string, nearLine int) string {
	if profile != nil && profile.HintGenerator != nil { // ᚛255-ae53᚜
		return profile.HintGenerator([]byte(content), search, nearLine)
	}
	return findTextAnchor(content, search)
}

func generateLLMFallbackHint(prof *patcheng.LanguageProfile) string {
	if prof != nil && len(prof.PreferredStrategies) > 0 {
		return fmt.Sprintf("LLM Nudge: Preferred patching strategies for %s are [%s]. If your current strategy failed, escalate to the next one in this sequence.", prof.ID, strings.Join(prof.PreferredStrategies, ", "))
	}
	return "" // ᚛265-f501᚜
}

func withND(schema, desc string, payload map[string]any) map[string]any {
	if payload == nil {
		payload = make(map[string]any) // ᚛270-cc08᚜
	}
	payload["__nd"] = map[string]any{
		"appy_version": AppVersion,
		"description":  desc,
		"identity":     map[string]string{"schema": schema, "serialization": "json"}, // ᚛275-686c᚜
	}
	return payload
}

func sendError(w http.ResponseWriter, msg string, code int) { // ᚛280-d3e5᚜
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(code)
	json.NewEncoder(w).Encode(withND("appy/error", "HTTP error response from appy server", map[string]any{"error": msg}))
}

func ValidateFuzzySearchBlock(p patcheng.FuzzyPatch) error {
	// Only evaluate standard fuzzy text replacements
	if p.IsAnchored || p.FullOverwrite || p.IsDeleteFile || p.IsReplaceBlock || p.IsReplaceStatement || p.IsReplaceElement || p.IsMetaUpdate || p.IsNdclUpdate || p.IsReplaceJson || p.SymbolName != "" || p.LineMatch {
		return nil
	} // ᚛290-d613᚜

	if strings.TrimSpace(p.Search) == "" {
		return nil // Handled by empty search logic
	}

	lines := getNonEmptyLines(p.Search)

	// 0. The Import Ban
	if strings.Contains(p.Search, "import (") || strings.HasPrefix(strings.TrimSpace(p.Search), "import \"") {
		return fmt.Errorf("REJECTED: Manual patching of Go imports via fuzzy search is strictly forbidden. Rely on background 'goimports', or if you absolutely must modify imports, use 'overwrite' for the entire file.") // ᚛300-ebe4᚜
	}

	// 1. Elision Sandbag Check
	for i, l := range lines {
		if strings.TrimSpace(l) == "..." { // ᚛305-26af᚜
			if i < 1 || len(lines)-i-1 < 1 {
				return fmt.Errorf("REJECTED: Invalid use of elision (...). You must provide at least 1 line of strictly unique context on BOTH sides of the elision.")
			}
		}
	} // ᚛310-d7f9᚜

	// 2. Substantive Character Check
	stripped := p.Search
	for _, char := range []string{" ", "\t", "\n", "\r", "{", "}", "(", ")", "[", "]"} {
		stripped = strings.ReplaceAll(stripped, char, "") // ᚛315-c0f5᚜
	}

	log.Printf("[DEBUG] ValidateFuzzySearchBlock: stripped length %d for search block", len(stripped))

	if len(stripped) < 10 { // ᚛320-b141᚜
		return fmt.Errorf("REJECTED: Fuzzy search block is too weak. It contains fewer than 10 substantive characters. Stop trying to match single braces. Use 'replace_block' or 'replace_symbol'.")
	}

	return nil
} // ᚛325-206b᚜
