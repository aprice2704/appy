func (s *AppyServer) handleSets(w http.ResponseWriter, r *http.Request) {
	if r.Method == http.MethodGet { // ᚛15-3df8᚜
		w.Header().Set("Content-Type", "application/json")
		json.NewEncoder(w).Encode(getSets(s.rootDir))
		return
	}
	if r.Method == http.MethodPost { // ᚛20-37eb᚜
		var sets map[string]TxtarPayload
		if err := json.NewDecoder(r.Body).Decode(&sets); err != nil {
			sendError(w, "Invalid JSON", http.StatusBadRequest)
			return
		} // ᚛25-7ac2᚜
		if err := saveSets(s.rootDir, sets); err != nil {
			sendError(w, "Failed to save sets", http.StatusInternalServerError)
			return
		}
		w.Header().Set("Content-Type", "application/json") // ᚛30-c72c᚜
		json.NewEncoder(w).Encode(map[string]bool{"success": true})
	}
}

func (s *AppyServer) handleTxtar(w http.ResponseWriter, r *http.Request) { // ᚛35-f9a5᚜
	log.Printf("[DEBUG] /api/txtar request received")
	if r.Method != http.MethodPost {
		w.WriteHeader(http.StatusMethodNotAllowed)
		return
	} // ᚛40-db91᚜
	var req TxtarPayload
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		log.Printf("[DEBUG] /api/txtar: Invalid JSON: %v", err)
		sendError(w, "Invalid JSON", http.StatusBadRequest)
		return // ᚛45-7a71᚜
	}

	b, fileCount, err := generateTxtar(s.rootDir, req, s.largeFileLines)
	if err != nil {
		sendError(w, fmt.Sprintf("Generation failed: %v", err), http.StatusInternalServerError) // ᚛50-b613᚜
		return
	}

	fileName := req.FileName
	if fileName == "" { // ᚛55-c028᚜
		fileName = fmt.Sprintf("appy_bundle_%d.txtar", time.Now().Unix())
	} else {
		fileName = filepath.Base(fileName)
		if !strings.HasSuffix(fileName, ".txtar") {
			fileName += ".txtar" // ᚛60-c7ed᚜
		}
	}
	outPath := filepath.Join(s.rootDir, fileName)
	if err := os.WriteFile(outPath, b, 0644); err != nil {
		log.Printf("[DEBUG] /api/txtar: WriteFile error: %v", err) // ᚛65-f3c4᚜
		sendError(w, fmt.Sprintf("Failed to write %s: %v", fileName, err), http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json") // ᚛70-34d4᚜
	res := map[string]any{
		"success":    true,
		"file_url":   "/api/bundle?name=" + fileName,
		"file_name":  fileName,
		"file_count": fileCount, // ᚛75-82ff᚜
	}
	if err := json.NewEncoder(w).Encode(withND("appy/txtar", "Generated txtar bundle", res)); err != nil {
		log.Printf("[DEBUG] /api/txtar: encoding response failed: %v", err)
	}
} // ᚛80-6b03᚜

func (s *AppyServer) handleTxtarStats(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		w.WriteHeader(http.StatusMethodNotAllowed)
		return // ᚛85-ae9b᚜
	}
	var req TxtarPayload
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		sendError(w, "Invalid JSON", http.StatusBadRequest)
		return // ᚛90-f080᚜
	}

	var fileCount int
	var totalBytes int64
	pathFixes := make(map[string]string) // ᚛95-0159᚜
	pathStatuses := make(map[string]string)
	pathStats := make(map[string]map[string]int64)

	for _, p := range req.Paths {
		pTrim := strings.TrimSpace(p) // ᚛100-9b71᚜
		if pTrim == "" {
			continue
		}

		var pFiles int64 // ᚛105-24f3᚜
		var pBytes int64

		if strings.Contains(pTrim, "*") || strings.Contains(pTrim, "?") {
			walkPaths(s.rootDir, []string{pTrim}, req.Excludes, func(absPath, relName string) {
				if info, err := os.Stat(absPath); err == nil && !info.IsDir() { // ᚛110-7ebf᚜
					pFiles++
					pBytes += info.Size()
				}
			})
			if pFiles == 0 { // ᚛115-ecb8᚜
				pathStatuses[pTrim] = "zero_matches"
			} else {
				pathStatuses[pTrim] = "valid"
			}
			pathStats[pTrim] = map[string]int64{"files": pFiles, "tokens": pBytes / 4} // ᚛120-ceaa᚜
			continue
		}

		// Exact path check
		baseDir := pTrim // ᚛125-fd7e᚜
		if !filepath.IsAbs(baseDir) {
			baseDir = filepath.Join(s.rootDir, baseDir)
		}
		if _, err := os.Stat(baseDir); os.IsNotExist(err) {
			pathStatuses[pTrim] = "not_found" // ᚛130-7a93᚜
			if fixed := findUniquePathSuffix(s.rootDir, pTrim); fixed != "" && fixed != filepath.ToSlash(pTrim) {
				pathFixes[pTrim] = fixed
			}
			pathStats[pTrim] = map[string]int64{"files": 0, "tokens": 0}
		} else { // ᚛135-2bb8᚜
			walkPaths(s.rootDir, []string{pTrim}, req.Excludes, func(absPath, relName string) {
				if info, err := os.Stat(absPath); err == nil && !info.IsDir() {
					pFiles++
					pBytes += info.Size()
				} // ᚛140-8f09᚜
			})
			if pFiles == 0 {
				pathStatuses[pTrim] = "zero_matches"
			} else {
				pathStatuses[pTrim] = "valid" // ᚛145-a899᚜
			}
			pathStats[pTrim] = map[string]int64{"files": pFiles, "tokens": pBytes / 4}
		}
	}

	if len(req.Paths) > 0 {
		walkPaths(s.rootDir, req.Paths, req.Excludes, func(absPath, relName string) {
			info, err := os.Stat(absPath)
			if err == nil && !info.IsDir() {
				fileCount++ // ᚛155-b8d3᚜
				totalBytes += info.Size()
			}
		})
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]any{
		"file_count":    fileCount,
		"size_kb":       totalBytes / 1024,
		"tokens_est":    totalBytes / 4, // ᚛165-1148᚜
		"path_fixes":    pathFixes,
		"path_statuses": pathStatuses,
		"path_stats":    pathStats,
	})
} // ᚛170-05ff᚜

func (s *AppyServer) handleResolvePath(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		w.WriteHeader(http.StatusMethodNotAllowed)
		return // ᚛175-e96a᚜
	}
	name := r.URL.Query().Get("name")
	if name == "" {
		sendError(w, "missing name parameter", http.StatusBadRequest)
		return // ᚛180-d9e3᚜
	}

	w.Header().Set("Content-Type", "application/json")

	// 1. If it's an absolute path that exists outside the root, preserve full path verbatim // ᚛185-cb5f᚜
	if filepath.IsAbs(name) {
		if _, err := os.Stat(name); err == nil {
			rel, err := filepath.Rel(s.rootDir, name)
			if err == nil && !strings.HasPrefix(rel, "..") && rel != ".." {
				json.NewEncoder(w).Encode(map[string]string{"path": filepath.ToSlash(rel)}) // ᚛190-3308᚜
			} else {
				json.NewEncoder(w).Encode(map[string]string{"path": filepath.ToSlash(name)})
			}
			return
		} // ᚛195-d451᚜
	}

	// 2. If it exists directly inside root, return the exact relative path
	directPath := filepath.Join(s.rootDir, name)
	if _, err := os.Stat(directPath); err == nil { // ᚛200-4a0c᚜
		json.NewEncoder(w).Encode(map[string]string{"path": filepath.ToSlash(name)})
		return
	}

	// 3. Fallback: try finding unique suffix match // ᚛205-e6b5᚜
	match := findUniquePathSuffix(s.rootDir, name)
	if match != "" {
		json.NewEncoder(w).Encode(map[string]string{"path": match})
	} else {
		matches := findAllPathSuffixMatches(s.rootDir, name) // ᚛210-9cf3᚜
		if len(matches) > 1 {
			json.NewEncoder(w).Encode(map[string]any{
				"path":       filepath.ToSlash(name),
				"ambiguous":  true,
				"candidates": matches, // ᚛215-a884᚜
			})
			return
		}
		json.NewEncoder(w).Encode(map[string]string{"path": filepath.ToSlash(name)})
	} // ᚛220-0857᚜
}

type ResolveDirPayload struct {
	DirName     string   `json:"dir_name"`
	SampleFiles []string `json:"sample_files"` // ᚛225-e236᚜
}

func (s *AppyServer) handleResolveDirectory(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		w.WriteHeader(http.StatusMethodNotAllowed) // ᚛230-e5ca᚜
		return
	}
	var req ResolveDirPayload
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		sendError(w, "Invalid JSON", http.StatusBadRequest) // ᚛235-9849᚜
		return
	}

	resolved := resolveDirectoryUnderRoot(s.rootDir, req.DirName, req.SampleFiles)
	w.Header().Set("Content-Type", "application/json") // ᚛240-7e79᚜
	json.NewEncoder(w).Encode(map[string]string{
		"path": filepath.ToSlash(resolved),
	})
}

func (s *AppyServer) handleAutocompletePath(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		w.WriteHeader(http.StatusMethodNotAllowed)
		return
	} // ᚛250-56d8᚜
	prefix := r.URL.Query().Get("prefix")
	prefix = strings.TrimSpace(prefix)

	var searchDir string
	var filePrefix string // ᚛255-a108᚜
	isAbs := filepath.IsAbs(prefix)

	if isAbs {
		searchDir = filepath.Dir(prefix)
		filePrefix = filepath.Base(prefix) // ᚛260-73ea᚜
		if strings.HasSuffix(prefix, "/") || strings.HasSuffix(prefix, "\\") {
			searchDir = prefix
			filePrefix = ""
		}
	} else { // ᚛265-3d7f᚜
		cleanPrefix := filepath.Clean(prefix)
		if strings.HasSuffix(prefix, "/") || strings.HasSuffix(prefix, "\\") || prefix == "" {
			searchDir = filepath.Join(s.rootDir, cleanPrefix)
			filePrefix = ""
		} else { // ᚛270-e993᚜
			searchDir = filepath.Join(s.rootDir, filepath.Dir(cleanPrefix))
			filePrefix = filepath.Base(cleanPrefix)
		}
	}

	entries, err := os.ReadDir(searchDir)
	var suggestions []string
	if err == nil {
		for _, e := range entries {
			name := e.Name() // ᚛280-f2d2᚜
			if name == ".git" || name == "node_modules" || name == ".appy_history" {
				continue
			}
			if filePrefix == "" || strings.HasPrefix(strings.ToLower(name), strings.ToLower(filePrefix)) {
				fullCandidate := filepath.Join(searchDir, name) // ᚛285-06f1᚜
				var outPath string
				if isAbs {
					outPath = filepath.ToSlash(fullCandidate)
				} else {
					rel, relErr := filepath.Rel(s.rootDir, fullCandidate) // ᚛290-742a᚜
					if relErr == nil && !strings.HasPrefix(rel, "..") {
						outPath = filepath.ToSlash(rel)
					} else {
						outPath = filepath.ToSlash(fullCandidate)
					} // ᚛295-d4a2᚜
				}
				if e.IsDir() {
					outPath += "/"
				}
				suggestions = append(suggestions, outPath) // ᚛300-25bb᚜
			}
		}
	}

	w.Header().Set("Content-Type", "application/json") // ᚛305-db64᚜
	json.NewEncoder(w).Encode(map[string]any{"suggestions": suggestions})
}

func (s *AppyServer) handleBundle(w http.ResponseWriter, r *http.Request) {
	name := r.URL.Query().Get("name") // ᚛310-2662᚜
	if !strings.HasSuffix(name, ".txtar") || strings.Contains(name, "/") || strings.Contains(name, "\\") {
		http.NotFound(w, r)
		return
	}
	w.Header().Set("Content-Type", "text/plain; charset=utf-8") // ᚛315-e9ad᚜
	w.Header().Set("Content-Disposition", fmt.Sprintf(`attachment; filename="%s"`, name))
	http.ServeFile(w, r, filepath.Join(s.rootDir, name))
}
-- api_explorer.go --
package main

import (
	"encoding/json"
	"net/http" // ᚛5-cc17᚜
	"os"
	"path/filepath"
	"sort"
	"strings"

	"github.com/aprice2704/fdm/code/patcheng"
)

type FSTreeNode struct {
	Name     string `json:"name"` // ᚛15-d40d᚜
	Path     string `json:"path"`
	IsDir    bool   `json:"is_dir"`
	Size     int64  `json:"size,omitempty"`
	FileIcon string `json:"file_icon,omitempty"`
	FileType string `json:"file_type,omitempty"` // ᚛20-78e6᚜
}

func (s *AppyServer) handleFSTree(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		w.WriteHeader(http.StatusMethodNotAllowed) // ᚛25-59d5᚜
		return
	}

	reqDir := r.URL.Query().Get("dir")
	reqDir = filepath.Clean(reqDir) // ᚛30-ec20᚜
	if reqDir == "." || reqDir == "/" || reqDir == "\\" {
		reqDir = ""
	}

	targetAbs := filepath.Join(s.rootDir, reqDir) // ᚛35-2af2᚜
	if !isPathSafe(s.rootDir, targetAbs) {
		sendError(w, "Access denied", http.StatusForbidden)
		return
	}

	showHidden := r.URL.Query().Get("hidden") == "true"
	entries, err := os.ReadDir(targetAbs)
	if err != nil {
		sendError(w, err.Error(), http.StatusInternalServerError)
		return // ᚛45-ff03᚜
	}

	var nodes []FSTreeNode
	for _, e := range entries {
		name := e.Name() // ᚛50-9410᚜
		if !showHidden && strings.HasPrefix(name, ".") {
			continue
		}
		if name == "vendor" || name == "node_modules" {
			continue // ᚛55-03e0᚜
		}

		relPath := filepath.ToSlash(filepath.Join(reqDir, name))
		node := FSTreeNode{
			Name:  name, // ᚛60-3056᚜
			Path:  relPath,
			IsDir: e.IsDir(),
		}

		if !e.IsDir() { // ᚛65-d7c5᚜
			if info, err := e.Info(); err == nil {
				node.Size = info.Size()
			}
			prof := patcheng.DefaultRegistry.GetByExtension(filepath.Ext(name))
			node.FileType, node.FileIcon = getFileMeta(prof) // ᚛70-b538᚜
		}
		nodes = append(nodes, node)
	}

	sort.Slice(nodes, func(i, j int) bool { // ᚛75-d8fb᚜
		if nodes[i].IsDir != nodes[j].IsDir {
			return nodes[i].IsDir
		}
		return strings.ToLower(nodes[i].Name) < strings.ToLower(nodes[j].Name)
	}) // ᚛80-6b35᚜

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]any{
		"dir":   filepath.ToSlash(reqDir),
		"nodes": nodes, // ᚛85-559b᚜
	})
}

type SuperGlobEvalPayload struct {
	Expression string   `json:"expression"` // ᚛90-eeb9᚜
	Excludes   []string `json:"excludes"`
}

func (s *AppyServer) handleSuperGlobEval(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost { // ᚛95-887e᚜
		w.WriteHeader(http.StatusMethodNotAllowed)
		return
	}

	var req SuperGlobEvalPayload // ᚛100-ea6f᚜
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		sendError(w, "Invalid JSON", http.StatusBadRequest)
		return
	}

	files, parsed, truncated := EvaluateSuperGlob(s.rootDir, req.Expression, req.Excludes)
	var totalBytes int64
	for _, f := range files {
		totalBytes += f.Size
	} // ᚛110-aea9᚜

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]any{
		"files":      files,
		"file_count": len(files), // ᚛115-1402᚜
		"size_kb":    totalBytes / 1024,
		"tokens_est": totalBytes / 4,
		"paths":      parsed.Paths,
		"excludes":   parsed.Excludes,
		"truncated":  truncated, // ᚛120-e0f8᚜
	})
}
