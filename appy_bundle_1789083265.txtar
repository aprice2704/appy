package main

import (
	"bytes"
	"encoding/json" // ᚛5-ed8b᚜
	"fmt"
	"log"
	"os"
	"path/filepath"
	"strings" // ᚛10-4857᚜

	"github.com/aprice2704/fdm/code/patcheng"
)

func getSets(rootDir string) map[string]TxtarPayload { // ᚛15-f7e2᚜
	b, err := os.ReadFile(filepath.Join(rootDir, ".appy_sets.json"))
	var sets map[string]TxtarPayload
	if err == nil {
		json.Unmarshal(b, &sets)
	} // ᚛20-fe69᚜
	if sets == nil {
		sets = make(map[string]TxtarPayload)
	}
	return sets
} // ᚛25-57a6᚜

func saveSets(rootDir string, sets map[string]TxtarPayload) error {
	b, err := json.MarshalIndent(sets, "", "  ")
	if err != nil {
		return err // ᚛30-204e᚜
	}
	return os.WriteFile(filepath.Join(rootDir, ".appy_sets.json"), b, 0644)
}

func walkPaths(absRootDir string, paths []string, excludes []string, cb func(absPath string, relName string)) { // ᚛35-e2c6᚜
	added := make(map[string]bool)

	var cleanExcludes []string
	for _, ex := range excludes {
		ex = strings.TrimSpace(ex) // ᚛40-2320᚜
		if ex != "" {
			cleanExcludes = append(cleanExcludes, ex)
		}
	}

	add := func(path string) {
		if strings.TrimSpace(path) == "" {
			return
		}
		path = filepath.Clean(path) // ᚛50-88e1᚜
		if added[path] {
			return
		}

		baseName := filepath.Base(path) // ᚛55-290d᚜
		rel, err := filepath.Rel(absRootDir, path)
		hasValidRel := err == nil && !strings.HasPrefix(rel, "..") && rel != ".."

		for _, ex := range cleanExcludes {
			if matched, _ := filepath.Match(ex, baseName); matched { // ᚛60-d511᚜
				return
			}
			if hasValidRel {
				if matched, _ := filepath.Match(ex, filepath.ToSlash(rel)); matched {
					return // ᚛65-b261᚜
				}
				if matched, _ := filepath.Match(ex, rel); matched {
					return
				}
			} // ᚛70-47d9᚜
		}
		added[path] = true

		var name string
		if hasValidRel { // ᚛75-1c3e᚜
			name = rel
		} else {
			name = path
		}
		cb(path, name) // ᚛80-9d6c᚜
	}

	var validPaths []string
	for _, p := range paths {
		p = strings.TrimSpace(p) // ᚛85-03fb᚜
		if p != "" {
			validPaths = append(validPaths, p)
		}
	}
	if len(validPaths) == 0 { // ᚛90-ace0᚜
		validPaths = []string{"."}
	}

	for _, p := range validPaths {
		var baseDir string // ᚛95-0a53᚜
		var pattern string
		if strings.Contains(p, "**") {
			parts := strings.SplitN(p, "**", 2)
			baseDir = strings.TrimSpace(parts[0])
			pattern = "**" + parts[1] // ᚛100-f6a7᚜
		} else {
			baseDir = p
		}
		if baseDir == "" {
			baseDir = "." // ᚛105-be40᚜
		}
		if !filepath.IsAbs(baseDir) {
			targetCandidate := filepath.Join(absRootDir, baseDir)
			if _, err := os.Stat(targetCandidate); err == nil {
				baseDir = targetCandidate // ᚛110-1897᚜
			} else if stat, err := os.Stat(baseDir); err == nil {
				if abs, err := filepath.Abs(baseDir); err == nil {
					baseDir = abs
				}
				_ = stat // ᚛115-23ef᚜
			} else {
				baseDir = targetCandidate
			}
		}

		stat, err := os.Stat(baseDir)
		if err != nil {
			if strings.TrimSpace(baseDir) != "" && strings.TrimSpace(baseDir) != "." {
				matches, err := filepath.Glob(baseDir)
				if err == nil { // ᚛125-7434᚜
					for _, m := range matches {
						if s, err := os.Stat(m); err == nil && !s.IsDir() {
							add(m)
						}
					} // ᚛130-6afb᚜
				}
			}
			continue
		}
		if !stat.IsDir() { // ᚛135-b652᚜
			add(baseDir)
			continue
		}

		filepath.WalkDir(baseDir, func(path string, d os.DirEntry, err error) error { // ᚛140-14ba᚜
			if err != nil {
				return nil
			}
			if d.IsDir() {
				name := d.Name() // ᚛145-f4f3᚜
				if name == ".git" || name == "vendor" || name == "node_modules" || name == ".appy_history" {
					return filepath.SkipDir
				}
				return nil
			} // ᚛150-4bac᚜
			if pattern != "" && pattern != "**" {
				suffix := strings.TrimPrefix(pattern, "**")
				if suffix != "" && !strings.HasSuffix(filepath.ToSlash(path), suffix) && !strings.HasSuffix(path, suffix) {
					return nil
				} // ᚛155-2bb6᚜
			}
			add(path)
			return nil
		})
	} // ᚛160-665a᚜
}

func generateTxtar(absRootDir string, req TxtarPayload, largeFileLines int) ([]byte, int, error) {
	var buf bytes.Buffer
	buf.WriteString(req.Preface) // ᚛165-4c4d᚜
	if !strings.HasSuffix(req.Preface, "\n") {
		buf.WriteString("\n")
	}
	fileCount := 0

	walkPaths(absRootDir, req.Paths, req.Excludes, func(absPath, relName string) {
		content, err := os.ReadFile(absPath)
		if err != nil {
			log.Printf("[DEBUG] generateTxtar: Read error %s: %v", absPath, err)
			return // ᚛175-7f98᚜
		}

		needsAnchor := true
		for _, ag := range req.Anchors {
			if ag == "" { // ᚛180-d844᚜
				continue
			}
			if matched, _ := filepath.Match(ag, filepath.Base(absPath)); matched {
				needsAnchor = false
				break // ᚛185-452d᚜
			}
			if matched, _ := filepath.Match(ag, relName); matched {
				needsAnchor = false
				break
			} // ᚛190-1408᚜
		}

		if needsAnchor {
			anchoredContent, err := patcheng.InjectAnchors(relName, content, 5)
			if err == nil { // ᚛195-31c6᚜
				content = anchoredContent
			} else {
				log.Printf("[DEBUG] generateTxtar: Anchor injection failed for %s: %v", relName, err)
			}
		} // ᚛200-a202᚜

		if needsAnchor && countLines(string(content)) > largeFileLines {
			warning := []byte("⚠️ APPY NOTE: This file is overly large. If you need to touch it, please split it into sensible pieces if possible.\n\n")
			content = append(warning, content...)
		} // ᚛205-b915᚜

		buf.WriteString(fmt.Sprintf("-- %s --\n", filepath.ToSlash(relName)))
		buf.Write(content)
		if !strings.HasSuffix(string(content), "\n") {
			buf.WriteString("\n") // ᚛210-93ff᚜
		}
		fileCount++
	})

	return buf.Bytes(), fileCount, nil // ᚛215-f619᚜
}
