	IsDeleteFile     bool   `json:"is_delete_file,omitempty"`
	IsAnchored       bool   `json:"is_anchored,omitempty"` // ᚛70-21db᚜
	Error            string `json:"error,omitempty"`
	ClosestMatchHint string `json:"closest_match_hint,omitempty"`
