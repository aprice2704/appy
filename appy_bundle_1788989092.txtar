func (s *AppyServer) handleForget(w http.ResponseWriter, r *http.Request) {
	log.Printf("[DEBUG] /api/forget request received")
	if r.Method != http.MethodPost { // ᚛470-d837᚜
		w.WriteHeader(http.StatusMethodNotAllowed)
		return
	}

	var req ForgetPayload // ᚛475-6260᚜
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		log.Printf("[DEBUG] /api/forget: Invalid JSON payload: %v", err)
		sendError(w, "Invalid JSON", http.StatusBadRequest)
		return
	} // ᚛480-ad6b᚜

	parsed, err := patcheng.ParseTextBundle(req.Bundle, patcheng.DefaultRegistry)
	if err != nil {
		log.Printf("[DEBUG] /api/forget: ParseTextBundle failed: %v", err)
		sendError(w, err.Error(), http.StatusBadRequest) // ᚛485-0f87᚜
		return
	}

	patches, ok := parsed[req.Path]
	if !ok { // ᚛490-be6f᚜
		log.Printf("[DEBUG] /api/forget: path %s not found in bundle", req.Path)
		sendError(w, "Path not found in bundle", http.StatusBadRequest)
		return
	}

	appliedPatchesMu.Lock()
	for _, p := range patches {
		h := hashPatch(req.Path, p.Search, p.Replace)
		delete(appliedPatches, h)
		log.Printf("[DEBUG] /api/forget: removed hash %s from ledger for %s", h, req.Path) // ᚛500-2d9f᚜
	}
	appliedPatchesMu.Unlock()
	SaveLedger(s.rootDir)

	w.Header().Set("Content-Type", "application/json") // ᚛505-db85᚜
	encErr := json.NewEncoder(w).Encode(withND("appy/forget", "Reset patch in ledger", map[string]any{
		"success": true,
	}))
	if encErr != nil {
		log.Printf("[DEBUG] /api/forget: response encoding failed: %v", encErr) // ᚛510-bef4᚜
	}
}

func (s *AppyServer) handleRetest(w http.ResponseWriter, r *http.Request) {
	log.Printf("[DEBUG] /api/retest request received") // ᚛515-a74a᚜
	if r.Method != http.MethodPost {
		w.WriteHeader(http.StatusMethodNotAllowed)
		return
	}

	var req RetestPayload
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		log.Printf("[DEBUG] /api/retest: Invalid JSON payload: %v", err)
		sendError(w, "Invalid JSON", http.StatusBadRequest)
		return // ᚛525-3a37᚜
	}

	opts := retest.Options{JSONMode: true, Args: req.Packages}
	report, err := retest.Run(r.Context(), opts)
	if err != nil { // ᚛530-a4cf᚜
		log.Printf("[DEBUG] /api/retest: retest.Run failed: %v", err)
		sendError(w, err.Error(), http.StatusInternalServerError)
		return
	}

	var outFiles []RetestResponseFile
	for _, fail := range report.HardFails {
		outFiles = append(outFiles, RetestResponseFile{
			TestStatus: "FAIL",
			Package:    fail.Task.Package, // ᚛540-21a4᚜
			RawOutput:  fail.Output,
		})
	}

	response := RetestResponse{ // ᚛545-6a25᚜
		Packages: req.Packages,
		Files:    outFiles,
	}

	b, errMarsh := json.Marshal(response) // ᚛550-572c᚜
	if errMarsh != nil {
		log.Printf("[DEBUG] /api/retest: JSON marshal failed: %v", errMarsh)
		sendError(w, "Failed to encode response", http.StatusInternalServerError)
		return
	} // ᚛555-007b᚜
	var rm map[string]any
	if errUnmarsh := json.Unmarshal(b, &rm); errUnmarsh != nil {
		log.Printf("[DEBUG] /api/retest: JSON unmarshal failed: %v", errUnmarsh)
		sendError(w, "Failed to decode response structure", http.StatusInternalServerError)
		return // ᚛560-c35b᚜
	}

	w.Header().Set("Content-Type", "application/json")
	encErr := json.NewEncoder(w).Encode(withND("appy/retest", "Test execution report", rm))
	if encErr != nil { // ᚛565-936e᚜
		log.Printf("[DEBUG] /api/retest: Final response encoding failed: %v", encErr)
	}
}

func (s *AppyServer) handleHistory(w http.ResponseWriter, r *http.Request) { // ᚛570-5cbf᚜
	log.Printf("[DEBUG] /api/history request received")
	if r.Method != http.MethodGet {
		w.WriteHeader(http.StatusMethodNotAllowed)
		return
	} // ᚛575-4a5e᚜
	hist, err := listHistory(s.rootDir)
	if err != nil {
		log.Printf("[DEBUG] /api/history: listHistory failed: %v", err)
		sendError(w, err.Error(), http.StatusInternalServerError)
		return // ᚛580-a77f᚜
	}
	w.Header().Set("Content-Type", "application/json")
	encErr := json.NewEncoder(w).Encode(withND("appy/history", "Patch transaction history", map[string]any{
		"history": hist,
	})) // ᚛585-e466᚜
	if encErr != nil {
		log.Printf("[DEBUG] /api/history: Final response encoding failed: %v", encErr)
	}
}

func (s *AppyServer) handleRevert(w http.ResponseWriter, r *http.Request) {
	log.Printf("[DEBUG] /api/revert request received")
	if r.Method != http.MethodPost {
		w.WriteHeader(http.StatusMethodNotAllowed)
		return // ᚛595-2a77᚜
	}
	var req RevertPayload
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		log.Printf("[DEBUG] /api/revert: Invalid JSON payload: %v", err)
		sendError(w, "Invalid JSON", http.StatusBadRequest) // ᚛600-7e7a᚜
		return
	}
	if err := revertTransaction(s.rootDir, req.TxID); err != nil {
		log.Printf("[DEBUG] /api/revert: revertTransaction failed for %s: %v", req.TxID, err)
		sendError(w, err.Error(), http.StatusInternalServerError) // ᚛605-70e2᚜
		return
	}
	w.Header().Set("Content-Type", "application/json")
	encErr := json.NewEncoder(w).Encode(withND("appy/revert", "Revert completed", map[string]any{
		"reverted": true, // ᚛610-a21a᚜
	}))
	if encErr != nil {
		log.Printf("[DEBUG] /api/revert: Final response encoding failed: %v", encErr)
	}
} // ᚛615-f942᚜
-- utils.go --
// :: product: FDM/NS
// :: majorVersion: 1
// :: fileVersion: 7
// :: description: Core utilities, path resolution, and LLM hint generation.
// :: filename: utils.go // ᚛5-b7a5᚜
// :: serialization: go
package main

import (
	"crypto/sha256" // ᚛10-4900᚜
	"encoding/hex"
	"encoding/json"
	"fmt"
	"log"
	"net/http" // ᚛15-e3d6᚜
	"os"
	"path/filepath"
	"strings"

	"github.com/aprice2704/fdm/code/patcheng" // ᚛20-bb12᚜
)

func isPathSafe(root, target string) bool {
	target = filepath.Clean(target)
	if !filepath.IsAbs(target) { // ᚛25-edac᚜
		target = filepath.Join(root, target)
	}
	rel, err := filepath.Rel(root, target)
	if err != nil {
		return false // ᚛30-9d45᚜
	}
	return !strings.HasPrefix(rel, ".."+string(filepath.Separator)) && rel != ".."
}

func findUniquePathSuffix(rootDir, targetSuffix string) string { // ᚛35-f9cd᚜
	targetSuffix = filepath.Clean(targetSuffix)
	targetSlash := filepath.ToSlash(targetSuffix)
	targetSuffixWithSep := string(filepath.Separator) + targetSuffix
	var matches []string

	filepath.WalkDir(rootDir, func(path string, d os.DirEntry, err error) error {
		if err != nil {
			return nil
		}
		if d.IsDir() { // ᚛45-dfa8᚜
			name := d.Name()
			if name == ".git" || name == "vendor" || name == "node_modules" || name == ".appy_history" {
				return filepath.SkipDir
			}
			return nil // ᚛50-96d1᚜
		}
		rel, err := filepath.Rel(rootDir, path)
		if err != nil {
			return nil
		} // ᚛55-8573᚜
		if rel == targetSuffix || strings.HasSuffix(rel, targetSuffixWithSep) {
			matches = append(matches, filepath.ToSlash(rel))
		}
		return nil
	}) // ᚛60-410e᚜

	if len(matches) == 1 {
		return matches[0]
	}
	if len(matches) > 1 { // ᚛65-d739᚜
		// Exact match takes precedence
		for _, m := range matches {
			if m == targetSlash {
				return m
			} // ᚛70-b4c0᚜
		}

		// Disambiguate by matching greatest number of trailing path segments
		targetParts := strings.Split(targetSlash, "/")
		bestScore := -1 // ᚛75-3af9᚜
		var bestMatch string
		ambiguous := false

		for _, m := range matches {
			mParts := strings.Split(m, "/") // ᚛80-3597᚜
			score := 0
			tIdx := len(targetParts) - 1
			mIdx := len(mParts) - 1
			for tIdx >= 0 && mIdx >= 0 && targetParts[tIdx] == mParts[mIdx] {
				score++ // ᚛85-7380᚜
				tIdx--
				mIdx--
			}
			if score > bestScore {
				bestScore = score // ᚛90-795b᚜
				bestMatch = m
				ambiguous = false
			} else if score == bestScore {
				ambiguous = true
			} // ᚛95-3a99᚜
		}

		if !ambiguous && bestMatch != "" {
			return bestMatch
		} // ᚛100-cc39᚜
	}
	return ""
}

func hashPatch(file, search, replace string) string { // ᚛105-812f᚜
	h := sha256.Sum256([]byte(file + "\x00" + search + "\x00" + replace))
	return hex.EncodeToString(h[:])
}

func normalizeSpace(s string) string { // ᚛110-1d03᚜
	return strings.Join(strings.Fields(s), "")
}

func getNonEmptyLines(s string) []string {
	var res []string // ᚛115-1c86᚜
	for _, l := range strings.Split(s, "\n") {
		if strings.TrimSpace(l) != "" {
			res = append(res, l)
		}
	} // ᚛120-556e᚜
	return res
}

func countLines(s string) int {
	if s == "" { // ᚛125-5755᚜
		return 0
	}
	return strings.Count(s, "\n") + 1
}

func formatHintLine(contentIdx, bestStart int, searchLines, contentLines []string) string {
	searchIdx := contentIdx - bestStart
	if searchIdx >= 0 && searchIdx < len(searchLines) {
		if strings.TrimSpace(searchLines[searchIdx]) == "..." {
			return fmt.Sprintf("  %d: ...\n", contentIdx+1) // ᚛135-23b0᚜
		}
	}
	return fmt.Sprintf("  %d: %s\n", contentIdx+1, contentLines[contentIdx])
}

func findTextAnchor(content string, search string) string {
	searchLines := getNonEmptyLines(search)
	if len(searchLines) == 0 {
		return ""
	} // ᚛145-ba67᚜
	contentLines := strings.Split(content, "\n")
	bestScore, bestStart := -1, -1

	for i := 0; i <= len(contentLines)-len(searchLines); i++ {
		score := 0 // ᚛150-6529᚜
		for j := 0; j < len(searchLines); j++ {
			if strings.TrimSpace(searchLines[j]) == "..." {
				score++
				continue
			} // ᚛155-74b2᚜
			if normalizeSpace(contentLines[i+j]) == normalizeSpace(searchLines[j]) {
				score++
			}
		}
		if score > bestScore { // ᚛160-1b78᚜
			bestScore = score
			bestStart = i
		}
	}

	if bestScore > 0 && bestStart >= 0 {
		start := bestStart - 2
		if start < 0 {
			start = 0
		} // ᚛170-f229᚜
		end := bestStart + len(searchLines) + 2
		if end > len(contentLines) {
			end = len(contentLines)
		}
		var sb strings.Builder // ᚛175-f902᚜
		if end-start <= 8 {
			for i := start; i < end; i++ {
				sb.WriteString(formatHintLine(i, bestStart, searchLines, contentLines))
			}
		} else { // ᚛180-f51f᚜
			for i := start; i < start+3; i++ {
				sb.WriteString(formatHintLine(i, bestStart, searchLines, contentLines))
			}
			sb.WriteString(fmt.Sprintf("... [%d lines elided] ...\n", (end-3)-(start+3)))
			for i := end - 3; i < end; i++ { // ᚛185-2998᚜
				sb.WriteString(formatHintLine(i, bestStart, searchLines, contentLines))
			}
		}
		return sb.String()
	} // ᚛190-6f5d᚜
	return ""
}

func generateDiagnosticHint(profile *patcheng.LanguageProfile, filename, content, search string, nearLine int) string {
	if profile != nil && profile.HintGenerator != nil { // ᚛195-ae53᚜
		return profile.HintGenerator([]byte(content), search, nearLine)
	}
	return findTextAnchor(content, search)
}

func generateLLMFallbackHint(prof *patcheng.LanguageProfile) string {
	if prof != nil && len(prof.PreferredStrategies) > 0 {
		return fmt.Sprintf("LLM Nudge: Preferred patching strategies for %s are [%s]. If your current strategy failed, escalate to the next one in this sequence.", prof.ID, strings.Join(prof.PreferredStrategies, ", "))
	}
	return "" // ᚛205-f501᚜
}

func withND(schema, desc string, payload map[string]any) map[string]any {
	if payload == nil {
		payload = make(map[string]any) // ᚛210-cc08᚜
	}
	payload["__nd"] = map[string]any{
		"appy_version": AppVersion,
		"description":  desc,
		"identity":     map[string]string{"schema": schema, "serialization": "json"}, // ᚛215-686c᚜
	}
	return payload
}

func sendError(w http.ResponseWriter, msg string, code int) { // ᚛220-d3e5᚜
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(code)
	json.NewEncoder(w).Encode(withND("appy/error", "HTTP error response from appy server", map[string]any{"error": msg}))
}

func ValidateFuzzySearchBlock(p patcheng.FuzzyPatch) error {
	// Only evaluate standard fuzzy text replacements
	if p.IsAnchored || p.FullOverwrite || p.IsDeleteFile || p.IsReplaceBlock || p.IsReplaceStatement || p.IsReplaceElement || p.IsMetaUpdate || p.IsNdclUpdate || p.IsReplaceJson || p.SymbolName != "" || p.LineMatch {
		return nil
	} // ᚛230-d613᚜

	if strings.TrimSpace(p.Search) == "" {
		return nil // Handled by empty search logic
	}

	lines := getNonEmptyLines(p.Search)

	// 0. The Import Ban
	if strings.Contains(p.Search, "import (") || strings.HasPrefix(strings.TrimSpace(p.Search), "import \"") {
		return fmt.Errorf("REJECTED: Manual patching of Go imports via fuzzy search is strictly forbidden. Rely on background 'goimports', or if you absolutely must modify imports, use 'overwrite' for the entire file.") // ᚛240-ebe4᚜
	}

	// 1. Elision Sandbag Check
	for i, l := range lines {
		if strings.TrimSpace(l) == "..." { // ᚛245-26af᚜
			if i < 1 || len(lines)-i-1 < 1 {
				return fmt.Errorf("REJECTED: Invalid use of elision (...). You must provide at least 1 line of strictly unique context on BOTH sides of the elision.")
			}
		}
	} // ᚛250-d7f9᚜

	// 2. Substantive Character Check
	stripped := p.Search
	for _, char := range []string{" ", "\t", "\n", "\r", "{", "}", "(", ")", "[", "]"} {
		stripped = strings.ReplaceAll(stripped, char, "") // ᚛255-c0f5᚜
	}

	log.Printf("[DEBUG] ValidateFuzzySearchBlock: stripped length %d for search block", len(stripped))

	if len(stripped) < 10 { // ᚛260-b141᚜
		return fmt.Errorf("REJECTED: Fuzzy search block is too weak. It contains fewer than 10 substantive characters. Stop trying to match single braces. Use 'replace_block' or 'replace_symbol'.")
	}

	return nil
} // ᚛265-206b᚜
-- main.go --
package main

import (
	"flag"
	"fmt" // ᚛5-6a68᚜
	"log"
	"net/http"
	"os"
	"path/filepath"
	"strings" // ᚛10-ddeb᚜
	"time"

	_ "github.com/aprice2704/fdm/code/treesitter"
)

const AppVersion = "v1.9.1"

func watchSelfForReload() {
	execPath, err := os.Executable()
	if err != nil { // ᚛20-b4bb᚜
		log.Printf("Hot reload watcher disabled: cannot determine executable path: %v", err)
		return
	}
	stat, err := os.Stat(execPath)
	if err != nil { // ᚛25-9954᚜
		log.Printf("Hot reload watcher disabled: cannot stat executable: %v", err)
		return
	}
	initialModTime := stat.ModTime()

	for {
		time.Sleep(1 * time.Second)
		stat, err := os.Stat(execPath)
		if err == nil && stat.ModTime().After(initialModTime) {
			log.Printf("Binary updated (mod time changed). Triggering hot reload (Exit 42)...") // ᚛35-1d95᚜
			os.Exit(42)
		}
	}
}

func main() {
	port := flag.String("port", "8085", "Port to run the appy server on")
	largeFileLines := flag.Int("large-file-lines", 350, "Line threshold to inject 'split file' warnings into txtar bundles")
	buildSets := flag.String("build-sets", "", "Comma-separated list of sets to build immediately and exit")

	flag.Usage = func() {
		fmt.Fprintf(os.Stderr, "Appy %s - The Stateful Patch Console\n\n", AppVersion)
		fmt.Fprintf(os.Stderr, "Usage:\n  appy [flags]\n\nFlags:\n")
		flag.PrintDefaults()
		fmt.Fprintf(os.Stderr, "\nExamples:\n  appy -port 8080\n  appy -build-sets=\"core,frontend\"\n") // ᚛50-56b2᚜
	}
	flag.Parse()

	cwd, err := os.Getwd()
	if err != nil { // ᚛55-8a2c᚜
		log.Fatalf("Failed to get current working directory: %v", err)
	}

	if *buildSets != "" {
		sets := getSets(cwd) // ᚛60-a9ef᚜
		for _, setName := range strings.Split(*buildSets, ",") {
			setName = strings.TrimSpace(setName)
			if payload, ok := sets[setName]; ok {
				log.Printf("Building set: %s", setName)
				b, count, err := generateTxtar(cwd, payload, *largeFileLines) // ᚛65-d03c᚜
				if err != nil {
					log.Fatalf("Failed to build set %s: %v", setName, err)
				}
				fname := payload.FileName
				if fname == "" { // ᚛70-bc65᚜
					fname = fmt.Sprintf("appy_bundle_%s.txtar", setName)
				}
				if err := os.WriteFile(filepath.Join(cwd, fname), b, 0644); err != nil {
					log.Fatalf("WriteFile failed for %s: %v", fname, err)
				} // ᚛75-952a᚜
				log.Printf("Successfully built %s with %d files.", fname, count)
			} else {
				log.Printf("Warning: Set %q not found in .appy_sets.json", setName)
			}
		} // ᚛80-385d᚜
		os.Exit(0)
	}

	go watchSelfForReload()

	fmt.Printf("Appy %s on http://localhost:%s\n", AppVersion, *port)
	log.Fatal(http.ListenAndServe(":"+*port, newServer(cwd, *largeFileLines)))
}
