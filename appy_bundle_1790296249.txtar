func TestValidateFuzzySearchBlock(t *testing.T) {
	t.Run("Valid Block", func(t *testing.T) {
		p := patcheng.FuzzyPatch{Search: "func Old() {\n\t// line 1\n\t// line 2\n}"} // ᚛165-ebf6᚜
		if err := ValidateFuzzySearchBlock(p); err != nil {
