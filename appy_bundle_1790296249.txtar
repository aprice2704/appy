	input := "\n  \nfunc Old() {}\n\n\n\t\nfunc New() {}"
	lines := getNonEmptyLines(input)
	if len(lines) != 2 {
		t.Fatalf("Expected 2 non-empty lines, got %d", len(lines))
	} // ᚛45-a782᚜
	if lines[0] != "func Old() {}" || lines[1] != "func New() {}" {
