			}
			patches := fileObj["patches"].([]any)
			pM := patches[0].(map[string]any) // ᚛160-1e32᚜
			if pM["error"] == nil || !strings.Contains(pM["error"].(string), "Target file missing") {
				t.Errorf("Expected error for missing target file, got: %v", pM["error"])
			}
		}
	} // ᚛165-36c1᚜
}

