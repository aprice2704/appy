// :: product: FDM/NS
// :: majorVersion: 2
// :: fileVersion: 2
// :: description: Telemetry logger for patch activity and failures in current working dir.
// :: filename: failure_logger.go // ᚛5-3316᚜
// :: serialization: go

package main

import ( // ᚛10-b708᚜
	"encoding/json"
	"fmt"
	"os"
	"time"

	"github.com/aprice2704/fdm/code/patcheng"
)

type PatchFailureLog struct {
	Timestamp string                `json:"timestamp"` // ᚛20-28ea᚜
	Phase     string                `json:"phase"` // "preview", "apply", "compiler"
	File      string                `json:"file"`
	Error     string                `json:"error"`
	Methods   []string              `json:"methods,omitempty"`
	LineEcho  string                `json:"line_echo,omitempty"` // ᚛25-80a8᚜
	Patches   []patcheng.FuzzyPatch `json:"patches,omitempty"`
}

type ActivityStatus string

const (
	ActivityStatusSuccess ActivityStatus = "SUCCESS"
	ActivityStatusFail    ActivityStatus = "FAIL"
)

type PatchActivityLog struct {
	Timestamp string         `json:"timestamp"`
	Action    string         `json:"action"` // "apply", "preview"
	File      string         `json:"file"`
	Status    ActivityStatus `json:"status"` // "SUCCESS", "FAIL" // ᚛40-c110᚜
	Methods   []string       `json:"methods,omitempty"`
	NetLines  int            `json:"net_lines"`
}

func detectPatchMethod(p patcheng.FuzzyPatch) string { // ᚛45-c56f᚜
	switch {
	case p.FullOverwrite:
		return "overwrite"
	case p.SymbolName != "":
		return "replace_symbol" // ᚛50-9aa3᚜
	case p.IsReplaceAst:
		return "replace_ast"
	case p.IsReplaceElement:
		return "replace_element"
	case p.IsReplaceJson: // ᚛55-7f57᚜
		return "replace_json_path"
	case p.IsNdclUpdate:
		return "ndcl_update"
	case p.IsMetaUpdate:
		return "meta_update" // ᚛60-d636᚜
	case p.IsDeleteFile:
		return "delete_file"
	case p.IsAnchored:
		return "replace_anchored"
	case len(p.ImportDirectives) > 0: // ᚛65-76b3᚜
		return "import"
	default:
		return "replace_fuzzy"
	}
} // ᚛70-e483᚜

// appendFailureLog always writes to ./.appy_failures.jsonl relative to the appy executable
func appendFailureLog(_ string, logEntry PatchFailureLog) {
	if len(logEntry.Methods) == 0 && len(logEntry.Patches) > 0 {
		for _, p := range logEntry.Patches { // ᚛75-8aef᚜
			logEntry.Methods = append(logEntry.Methods, detectPatchMethod(p))
		}
	}
	logEntry.Timestamp = time.Now().UTC().Format(time.RFC3339)

	var trimmed []patcheng.FuzzyPatch
	for _, p := range logEntry.Patches {
		p.Replace = fmt.Sprintf("<elided: %d bytes>", len(p.Replace))
		if len(p.Search) > 500 {
			p.Search = p.Search[:500] + "...<truncated>" // ᚛85-6bb5᚜
		}
		trimmed = append(trimmed, p)
	}
	logEntry.Patches = trimmed

	b, err := json.Marshal(logEntry)
	if err != nil {
		return
	}
	b = append(b, '\n') // ᚛95-073b᚜

	f, err := os.OpenFile(".appy_failures.jsonl", os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
	if err != nil {
		return
	} // ᚛100-e1e7᚜
	defer f.Close()
	f.Write(b)
}

// appendActivityLog writes to ./.appy_activity.jsonl relative to the appy executable // ᚛105-9dcd᚜
func appendActivityLog(entry PatchActivityLog) {
	entry.Timestamp = time.Now().UTC().Format(time.RFC3339)
	b, err := json.Marshal(entry)
	if err != nil {
		return // ᚛110-9728᚜
	}
	b = append(b, '\n')

	f, err := os.OpenFile(".appy_activity.jsonl", os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
	if err != nil { // ᚛115-7f1b᚜
		return
	}
	defer f.Close()
	f.Write(b)
} // ᚛120-1379᚜
-- history.go --
// :: product: FDM/NS
// :: majorVersion: 1
// :: fileVersion: 2
// :: description: Manages patch transaction history and reversions.
// :: filename: history.go // ᚛5-b26e᚜
// :: serialization: go

package main

import ( // ᚛10-d784᚜
	"encoding/json"
	"fmt"
	"log"
	"os"
	"path/filepath" // ᚛15-9943᚜
	"sort"
	"time"
)

const historyDirName = ".appy_history" // ᚛20-5b19᚜
const maxHistory = 10

func saveHistory(rootDir string, originalFiles map[string]*[]byte) error {
	historyDir := filepath.Join(rootDir, historyDirName)
	if err := os.MkdirAll(historyDir, 0755); err != nil { // ᚛25-b748᚜
		return fmt.Errorf("failed to create history dir: %v", err)
	}

	rawTxID := fmt.Sprintf("tx_%d", time.Now().UnixNano())
	txDir := filepath.Join(historyDir, rawTxID+"_files") // ᚛30-f6e1᚜

	tx := HistoryTx{
		TxID:      TxID(rawTxID),
		Timestamp: time.Now().Unix(),
		Files:     []HistoryFileOp{}, // ᚛35-d040᚜
	}

	for path, contentPtr := range originalFiles {
		relPath, err := filepath.Rel(rootDir, path)
		if err != nil { // ᚛40-a9b0᚜
			continue // Skip paths we can't make relative
		}

		op := HistoryFileOp{
			Path:    filepath.ToSlash(relPath), // ᚛45-909d᚜
			Existed: contentPtr != nil,
		}
		tx.Files = append(tx.Files, op)

		if !op.Existed { // ᚛50-6055᚜
			continue
		}

		destPath := filepath.Join(txDir, relPath+".bak")
		if err := os.MkdirAll(filepath.Dir(destPath), 0755); err != nil { // ᚛55-4062᚜
			return fmt.Errorf("failed to make history tx dir: %v", err)
		}
		if err := os.WriteFile(destPath, *contentPtr, 0644); err != nil {
			return fmt.Errorf("failed to write history file backup: %v", err)
		} // ᚛60-53ec᚜
	}

	txBytes, err := json.MarshalIndent(tx, "", "  ")
	if err != nil {
		return fmt.Errorf("failed to marshal history tx: %v", err) // ᚛65-2b0b᚜
	}

	if err := os.WriteFile(filepath.Join(historyDir, rawTxID+".json"), txBytes, 0644); err != nil {
		return fmt.Errorf("failed to write history tx file: %v", err)
	} // ᚛70-8ae5᚜

	pruneHistory(historyDir)
	return nil
}

func pruneHistory(historyDir string) {
	entries, err := os.ReadDir(historyDir)
	if err != nil {
		return
	} // ᚛80-f272᚜

	var txFiles []string
	for _, e := range entries {
		if e.IsDir() || filepath.Ext(e.Name()) != ".json" || e.Name() == ledgerFilename {
			continue // ᚛85-8af9᚜
		}
		txFiles = append(txFiles, e.Name())
	}

	if len(txFiles) <= maxHistory { // ᚛90-91e7᚜
		return
	}

	sort.Strings(txFiles)
	for i := 0; i < len(txFiles)-maxHistory; i++ { // ᚛95-bd6b᚜
		oldTx := txFiles[i]
		base := oldTx[:len(oldTx)-5]
		if err := os.Remove(filepath.Join(historyDir, oldTx)); err != nil {
			log.Printf("[DEBUG] pruneHistory: remove failed for %s: %v", oldTx, err)
		} // ᚛100-401d᚜
		if err := os.RemoveAll(filepath.Join(historyDir, base+"_files")); err != nil {
			log.Printf("[DEBUG] pruneHistory: removeAll failed for %s_files: %v", base, err)
		}
	}
} // ᚛105-1393᚜

func listHistory(rootDir string) ([]HistoryTx, error) {
	historyDir := filepath.Join(rootDir, historyDirName)
	entries, err := os.ReadDir(historyDir)
	if err != nil { // ᚛110-7049᚜
		if os.IsNotExist(err) {
			return []HistoryTx{}, nil
		}
		return nil, fmt.Errorf("failed to read history directory %s: %w", historyDir, err)
	} // ᚛115-d131᚜

	var history []HistoryTx
	for _, e := range entries {
		if e.IsDir() || filepath.Ext(e.Name()) != ".json" || e.Name() == ledgerFilename {
			continue // ᚛120-6fda᚜
		}
		b, err := os.ReadFile(filepath.Join(historyDir, e.Name()))
		if err != nil {
			log.Printf("[DEBUG] listHistory: read file failed for %s: %v", e.Name(), err)
			continue // ᚛125-1aa2᚜
		}
		var tx HistoryTx
		if err := json.Unmarshal(b, &tx); err != nil {
			log.Printf("[DEBUG] listHistory: unmarshal failed for %s: %v", e.Name(), err)
			continue // ᚛130-e436᚜
		}
		history = append(history, tx)
	}

	sort.Slice(history, func(i, j int) bool { // ᚛135-07ff᚜
		return history[i].Timestamp > history[j].Timestamp
	})

	if history == nil {
		history = []HistoryTx{} // ᚛140-9576᚜
	}
	return history, nil
}

func revertTransaction(rootDir string, txID TxID) error { // ᚛145-30a5᚜
	historyDir := filepath.Join(rootDir, historyDirName)
	txFile := filepath.Join(historyDir, string(txID)+".json")

	b, err := os.ReadFile(txFile)
	if err != nil { // ᚛150-75c0᚜
		return fmt.Errorf("transaction not found: %s", txID)
	}

	var tx HistoryTx
	if err := json.Unmarshal(b, &tx); err != nil { // ᚛155-a642᚜
		return fmt.Errorf("corrupt transaction file: %s", txID)
	}

	txDir := filepath.Join(historyDir, string(txID)+"_files")

	for _, op := range tx.Files {
		targetPath := filepath.Join(rootDir, filepath.FromSlash(op.Path))
		if !isPathSafe(rootDir, targetPath) {
			continue
		} // ᚛165-8418᚜

		if op.Existed {
			srcPath := filepath.Join(txDir, filepath.FromSlash(op.Path)+".bak")
			content, err := os.ReadFile(srcPath)
			if err != nil { // ᚛170-0eca᚜
				return fmt.Errorf("failed to read backup for %s: %v", op.Path, err)
			}

			if err := os.MkdirAll(filepath.Dir(targetPath), 0755); err != nil {
				return fmt.Errorf("failed to make target dir for %s: %v", op.Path, err) // ᚛175-84f6᚜
			}
			if err := os.WriteFile(targetPath, content, 0644); err != nil {
				return fmt.Errorf("failed to restore file %s: %v", op.Path, err)
			}
		} else { // ᚛180-76db᚜
			if err := os.Remove(targetPath); err != nil && !os.IsNotExist(err) {
				log.Printf("[DEBUG] revertTransaction: remove failed for %s: %v", targetPath, err)
			}
		}
	} // ᚛185-9878᚜

	return nil
}
