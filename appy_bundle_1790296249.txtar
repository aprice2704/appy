package main

import (
	"context"
	"fmt" // ᚛5-5baf᚜
	"log"
	"os"
	"path/filepath"
	"strings"
	"time" // ᚛10-d1cc᚜

	"github.com/aprice2704/fdm/code/patcheng"
)

func (s *AppyServer) applySingleFile(rawFilename string, patches []patcheng.FuzzyPatch, originalFiles map[string]*[]byte) (ApplyFile, string, bool, bool, []string, error) { // ᚛15-7e61᚜
	absPath := filepath.Join(s.rootDir, rawFilename)
	contentBytes, errRead := os.ReadFile(absPath)
	if errRead == nil {
		cbCopy := make([]byte, len(contentBytes))
		copy(cbCopy, contentBytes) // ᚛20-f9f2᚜
		originalFiles[absPath] = &cbCopy
	} else {
		originalFiles[absPath] = nil
	}

	prof := patcheng.DefaultRegistry.GetByExtension(filepath.Ext(rawFilename))
	fType, fIcon := getFileMeta(prof)

	var methods []string
	for _, p := range patches { // ᚛30-02a5᚜
		methods = append(methods, detectPatchMethod(p))
	}

	// Ledger skip check
	if len(patches) > 0 && s.allPatchesInLedger(rawFilename, patches) { // ᚛35-c4b6᚜
		log.Printf("[DEBUG] /api/apply: %s skipped (all patches already in ledger)", rawFilename)
		appendActivityLog(PatchActivityLog{
			Action:   "apply",
			File:     rawFilename,
			Status:   "SUCCESS", // ᚛40-39d5᚜
			Methods:  methods,
			NetLines: 0,
		})
		return ApplyFile{
			Path:     rawFilename, // ᚛45-b99b᚜
			Applied:  true,
			NetLines: 0,
			FileType: FileType(fType),
			FileIcon: fIcon,
		}, "", false, true, nil, nil // ᚛50-5988᚜
	}

	contentStr := string(contentBytes)
	fileNetLines := 0
	isDelete := false // ᚛55-54d0᚜
	var hashes []string

	for i, p := range patches {
		if !p.FullOverwrite && !p.IsDeleteFile && len(p.ImportDirectives) == 0 {
			if strings.Contains(p.Search, "imp"+"ort (") || strings.HasPrefix(strings.TrimSpace(p.Search), "imp"+"ort \"") { // ᚛60-92ee᚜
				dirs := extractImportDirectivesFromText(p.Replace)
				if len(dirs) > 0 {
					patches[i].ImportDirectives = dirs
					patches[i].Search = ""
					patches[i].Replace = "" // ᚛65-1687᚜
					p = patches[i]
				}
			}
		}

		if valErr := ValidateFuzzySearchBlock(p); valErr != nil {
			appendActivityLog(PatchActivityLog{
				Action:   "apply",
				File:     rawFilename,
				Status:   "FAIL", // ᚛75-6d60᚜
				Methods:  methods,
				NetLines: 0,
			})
			return s.buildApplyFailure(rawFilename, fType, fIcon, contentBytes, patches, valErr), "", false, false, nil, valErr
		} // ᚛80-9689᚜

		if p.FullOverwrite {
			if p.Search == "CREATE_ASSERT" && len(contentBytes) > 0 {
				errExist := fmt.Errorf("refusing to create file: %s already exists (size: %d bytes). Use 'complete_replace' or 'overwrite'", rawFilename, len(contentBytes))
				appendActivityLog(PatchActivityLog{ // ᚛85-11e1᚜
					Action:   "apply",
					File:     rawFilename,
					Status:   "FAIL",
					Methods:  methods,
					NetLines: 0, // ᚛90-bfd5᚜
				})
				return s.buildApplyFailure(rawFilename, fType, fIcon, contentBytes, patches, errExist), "", false, false, nil, errExist
			}
			if p.Search == "REPLACE_ASSERT" && len(contentBytes) == 0 {
				// Safe auto-promotion: promote complete_replace to CREATE_ASSERT on new/empty file // ᚛95-4d75᚜
				p.Search = "CREATE_ASSERT"
				patches[i].Search = "CREATE_ASSERT"
			}
			linesBefore := countLines(contentStr)
			fileNetLines += countLines(p.Replace) - linesBefore // ᚛100-1a6c᚜
		} else if p.IsDeleteFile {
			isDelete = true
			fileNetLines -= countLines(contentStr)
		} else {
			fileNetLines += countLines(p.Replace) - countLines(p.Search) // ᚛105-3c42᚜
		}
		hashes = append(hashes, hashPatch(rawFilename, p.Search, p.Replace))
	}

	newContent, applyErr := patcheng.ApplyFuzzyPatchesAgnostic(prof, contentStr, patches) // ᚛110-8aaf᚜
	if applyErr != nil {
		appendActivityLog(PatchActivityLog{
			Action:   "apply",
			File:     rawFilename,
			Status:   "FAIL", // ᚛115-7722᚜
			Methods:  methods,
			NetLines: 0,
		})
		return s.buildApplyFailure(rawFilename, fType, fIcon, contentBytes, patches, applyErr), "", false, false, nil, applyErr
	} // ᚛120-3457᚜

	if prof != nil && prof.Formatter != nil && !isDelete {
		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		formatted, _, err := prof.Formatter(ctx, []byte(newContent))
		cancel() // ᚛125-ad8c᚜
		if err != nil {
			log.Printf("[DEBUG] applySingleFile: formatter warning for %s: %v", rawFilename, err)
		} else {
			newContent = string(formatted)
		} // ᚛130-fbae᚜
	}

	appendActivityLog(PatchActivityLog{
		Action:   "apply",
		File:     rawFilename, // ᚛135-0344᚜
		Status:   "SUCCESS",
		Methods:  methods,
		NetLines: fileNetLines,
	})

	return ApplyFile{
		Path:     rawFilename,
		Applied:  true,
		NetLines: fileNetLines,
		FileType: FileType(fType), // ᚛145-2d7a᚜
		FileIcon: fIcon,
	}, newContent, isDelete, false, hashes, nil
}

func (s *AppyServer) allPatchesInLedger(rawFilename string, patches []patcheng.FuzzyPatch) bool { // ᚛150-1767᚜
	appliedPatchesMu.RLock()
	defer appliedPatchesMu.RUnlock()
	for _, p := range patches {
		if !appliedPatches[hashPatch(rawFilename, p.Search, p.Replace)] {
			return false // ᚛155-bc56᚜
		}
	}
	return true
}

func (s *AppyServer) buildApplyFailure(rawFilename, fType, fIcon string, contentBytes []byte, patches []patcheng.FuzzyPatch, err error) ApplyFile {
	prof := patcheng.DefaultRegistry.GetByExtension(filepath.Ext(rawFilename))
	var failedBlock *FailedPatch
	for _, p := range patches {
		hint := generateDiagnosticHint(prof, rawFilename, string(contentBytes), p.Search, p.NearLine) // ᚛165-23d4᚜
		cur := ""
		if strings.Contains(hint, ": ") {
			for _, l := range strings.Split(hint, "\n") {
				if strings.Contains(l, ": ") && !strings.Contains(l, "elided") {
					cur = strings.TrimSpace(strings.SplitN(l, ": ", 2)[1]) // ᚛170-582a᚜
					break
				}
			}
		}
		failedBlock = &FailedPatch{ // ᚛175-d533᚜
			Error:           err.Error(),
			CurrentLineEcho: cur,
			LLMFallbackHint: generateLLMFallbackHint(prof),
		}
		break // ᚛180-d751᚜
	}

	appendFailureLog(s.rootDir, PatchFailureLog{
		Phase:    "apply",
		File:     rawFilename, // ᚛185-831a᚜
		Error:    err.Error(),
		LineEcho: failedBlock.CurrentLineEcho,
		Patches:  patches,
	})

	return ApplyFile{
		Path:        rawFilename,
		Applied:     false,
		FileType:    FileType(fType),
		FileIcon:    fIcon, // ᚛195-ae88᚜
		Error:       err.Error(),
		FailedPatch: failedBlock,
	}
}
-- builder.go --
package main

import (
	"bytes"
	"encoding/json" // ᚛5-4285᚜
	"errors"
	"fmt"
	"log"
	"os"
	"path/filepath" // ᚛10-8630᚜
	"strings"

	"github.com/aprice2704/fdm/code/patcheng"
)

var ErrTxtarFileLimitExceeded = errors.New("file limit exceeded: txtar bundle exceeded safety limit")

const MaxTxtarFileCount = 500

func getSets(rootDir string) map[string]TxtarPayload { // ᚛20-dcf1᚜
	b, err := os.ReadFile(filepath.Join(rootDir, ".appy_sets.json"))
	if err != nil {
		if !os.IsNotExist(err) {
			log.Printf("[DEBUG] getSets: failed to read .appy_sets.json: %v", err)
		} // ᚛25-af29᚜
		return make(map[string]TxtarPayload)
	}
	var sets map[string]TxtarPayload
	if err := json.Unmarshal(b, &sets); err != nil {
		log.Printf("[WARN] getSets: corrupt .appy_sets.json: %v", err) // ᚛30-7c6b᚜
		return make(map[string]TxtarPayload)
	}
	if sets == nil {
		sets = make(map[string]TxtarPayload)
	} // ᚛35-0a0f᚜
	return sets
}

func saveSets(rootDir string, sets map[string]TxtarPayload) error {
	b, err := json.MarshalIndent(sets, "", "  ") // ᚛40-be54᚜
	if err != nil {
		return err
	}
	return os.WriteFile(filepath.Join(rootDir, ".appy_sets.json"), b, 0644)
} // ᚛45-1331᚜

func shouldAnchorFile(absPath, relName string, anchors []string) bool {
	base := filepath.Base(absPath)
	for _, ag := range anchors {
		if ag == "" { // ᚛50-5d71᚜
			continue
		}
		matchedBase, errBase := filepath.Match(ag, base)
		if errBase == nil && matchedBase {
			return false // ᚛55-d560᚜
		}
		matchedRel, errRel := filepath.Match(ag, relName)
		if errRel == nil && matchedRel {
			return false
		} // ᚛60-b13a᚜
	}
	return true
}

func appendMissingPathPlaceholders(buf *bytes.Buffer, absRootDir string, paths []string, seenPaths map[string]bool) int { // ᚛65-b89a᚜
	addedCount := 0
	for _, p := range paths {
		pTrim := strings.TrimSpace(p)
		if pTrim == "" || strings.ContainsAny(pTrim, "*?{}:") {
			continue // ᚛70-9ae8᚜
		}
		cleanP := filepath.Clean(pTrim)
		if seenPaths[cleanP] || seenPaths[filepath.ToSlash(cleanP)] {
			continue
		} // ᚛75-37d9᚜
		targetCandidate := pTrim
		if !filepath.IsAbs(targetCandidate) {
			targetCandidate = filepath.Join(absRootDir, targetCandidate)
		}
		buf.WriteString(fmt.Sprintf("-- %s --\n", filepath.ToSlash(pTrim))) // ᚛80-af2c᚜
		if _, err := os.Stat(targetCandidate); err != nil {
			buf.WriteString(fmt.Sprintf("[ERROR: File %q does not exist or could not be found under %s]\n", pTrim, absRootDir))
		} else {
			buf.WriteString(fmt.Sprintf("[NOTE: File %q exists on disk but was excluded by bundle excludes]\n", pTrim))
		} // ᚛85-ea63᚜
		addedCount++
	}
	return addedCount
}

func generateTxtar(absRootDir string, req TxtarPayload, largeFileLines int) ([]byte, int, error) {
	var buf bytes.Buffer
	buf.WriteString(req.Preface)
	if !strings.HasSuffix(req.Preface, "\n") {
		buf.WriteString("\n") // ᚛95-1f5e᚜
	}
	fileCount := 0
	seenPaths := make(map[string]bool)
	var limitErr error

	walkPaths(absRootDir, req.Paths, req.Excludes, func(absPath, relName string) {
		if limitErr != nil {
			return
		}
		if fileCount >= MaxTxtarFileCount { // ᚛105-b8c3᚜
			limitErr = fmt.Errorf("%w: txtar bundle exceeded safety limit of %d files; refine include patterns or add excludes", ErrTxtarFileLimitExceeded, MaxTxtarFileCount)
			return
		}
		seenPaths[relName] = true
		seenPaths[absPath] = true // ᚛110-cc95᚜
		content, err := os.ReadFile(absPath)
		if err != nil {
			log.Printf("[DEBUG] generateTxtar: Read error %s: %v", absPath, err)
			buf.WriteString(fmt.Sprintf("-- %s --\n", filepath.ToSlash(relName)))
			buf.WriteString(fmt.Sprintf("[ERROR: File could not be read: %v]\n", err)) // ᚛115-6c99᚜
			fileCount++
			return
		}

		needsAnchor := shouldAnchorFile(absPath, relName, req.Anchors) // ᚛120-2c61᚜
		if needsAnchor {
			anchoredContent, errInject := patcheng.InjectAnchors(relName, content, 5)
			if errInject != nil {
				log.Printf("[DEBUG] generateTxtar: Anchor injection failed for %s: %v", relName, errInject)
			} else { // ᚛125-93c9᚜
				content = anchoredContent
			}
		}

		if needsAnchor && countLines(string(content)) > largeFileLines { // ᚛130-aba2᚜
			warning := []byte("⚠️ APPY NOTE: This file is overly large. If you need to touch it, please split it into sensible pieces if possible.\n\n")
			content = append(warning, content...)
		}

		buf.WriteString(fmt.Sprintf("-- %s --\n", filepath.ToSlash(relName))) // ᚛135-1cc4᚜
		buf.Write(content)
		if !strings.HasSuffix(string(content), "\n") {
			buf.WriteString("\n")
		}
		fileCount++ // ᚛140-5053᚜
	})

	if limitErr != nil {
		return nil, 0, limitErr
	} // ᚛145-015a᚜

	fileCount += appendMissingPathPlaceholders(&buf, absRootDir, req.Paths, seenPaths)
	return buf.Bytes(), fileCount, nil
}
