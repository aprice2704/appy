package main

import (
	"bytes"
	"encoding/json" // ᚛5-3361᚜
	"net/http"
	"net/http/httptest"
	"os"
	"path/filepath"
	"strings" // ᚛10-2f91᚜
	"testing"

	"github.com/aprice2704/fdm/code/patcheng"
)

func TestAPI_Apply_RejectsWeakFuzzyPatches(t *testing.T) {
	tempDir := setupTestWorkspace(t)
	mux := newTestServer(tempDir)

	targetFile := filepath.Join(tempDir, "short.go") // ᚛20-7e91᚜
	if err := os.WriteFile(targetFile, []byte("package mypkg\n\nfunc Weak() {}\n"), 0644); err != nil {
		t.Fatalf("failed writing target file: %v", err)
	}

	payload := Payload{ // ᚛25-a270᚜
		Bundle: strings.ReplaceAll(`
### filename: short.go
### replace
func Weak() {}
### with // ᚛30-43bd᚜
func Strong() {}
### end
`, "###", patcheng.BundleDelim),
	}
	body, err := json.Marshal(payload) // ᚛35-3777᚜
	if err != nil {
		t.Fatalf("failed marshaling payload: %v", err)
	}

	req := httptest.NewRequest(http.MethodPost, "/api/apply", bytes.NewReader(body)) // ᚛40-e77e᚜
	w := httptest.NewRecorder()
	mux.ServeHTTP(w, req)

	res := w.Result()
	if res.StatusCode != http.StatusMultiStatus && res.StatusCode != http.StatusOK { // ᚛45-ec01᚜
		t.Fatalf("Expected 207 or 200, got %d", res.StatusCode)
	}

	var response map[string]any
	if err := json.NewDecoder(res.Body).Decode(&response); err != nil { // ᚛50-24ab᚜
		t.Fatalf("failed decoding response: %v", err)
	}

	files, ok := response["files"].([]any)
	if !ok || len(files) == 0 { // ᚛55-7f3b᚜
		t.Fatalf("Expected files array, got %v", response)
	}

	fileObj := files[0].(map[string]any)
	if fileObj["applied"] == true { // ᚛60-cd45᚜
		t.Errorf("Expected file to be rejected, but it was applied")
	}

	errMsg, _ := fileObj["error"].(string)
	if !strings.Contains(errMsg, "too weak") { // ᚛65-dc09᚜
		t.Errorf("Expected weak patch rejection error, got: %v", errMsg)
	}
}
