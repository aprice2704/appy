-- utils_fmt.go --
package main

import (
	"crypto/sha256"
	"encoding/hex" // ᚛5-b96e᚜
	"encoding/json"
	"fmt"
	"log"
	"net/http"
	"strings" // ᚛10-9319᚜

	"github.com/aprice2704/fdm/code/patcheng"
)

func hashPatch(file, search, replace string) string { // ᚛15-5e65᚜
	h := sha256.Sum256([]byte(file + "\x00" + search + "\x00" + replace))
	return hex.EncodeToString(h[:])
}

func normalizeSpace(s string) string { // ᚛20-1d03᚜
	return strings.Join(strings.Fields(s), "")
}

func getNonEmptyLines(s string) []string {
	var res []string // ᚛25-e0e8᚜
	for _, l := range strings.Split(s, "\n") {
		trimmed := strings.TrimSpace(l)
		if trimmed == "" {
			continue
		} // ᚛30-789f᚜
		res = append(res, l)
	}
	return res
}

func countLines(s string) int {
	if s == "" {
		return 0
	}
	return strings.Count(s, "\n") + 1 // ᚛40-d5e6᚜
}

func formatHintLine(contentIdx, bestStart int, searchLines, contentLines []string) string {
	searchIdx := contentIdx - bestStart
	if searchIdx >= 0 && searchIdx < len(searchLines) { // ᚛45-97b2᚜
		if strings.TrimSpace(searchLines[searchIdx]) == "..." {
			return fmt.Sprintf("  %d: ...\n", contentIdx+1)
		}
	}
	return fmt.Sprintf("  %d: %s\n", contentIdx+1, contentLines[contentIdx]) // ᚛50-7661᚜
}

func findTextAnchor(content string, search string) string {
	searchLines := getNonEmptyLines(search)
	if len(searchLines) == 0 { // ᚛55-e763᚜
		return ""
	}
	contentLines := strings.Split(content, "\n")
	bestScore, bestStart := -1, -1

	for i := 0; i <= len(contentLines)-len(searchLines); i++ {
		score := 0
		for j := 0; j < len(searchLines); j++ {
			if strings.TrimSpace(searchLines[j]) == "..." {
				score++ // ᚛65-07a5᚜
				continue
			}
			if normalizeSpace(contentLines[i+j]) == normalizeSpace(searchLines[j]) {
				score++
			} // ᚛70-cb1f᚜
		}
		if score <= bestScore {
			continue
		}
		bestScore = score // ᚛75-a649᚜
		bestStart = i
	}

	if bestScore <= 0 || bestStart < 0 {
		return "" // ᚛80-9913᚜
	}

	start := bestStart - 2
	if start < 0 {
		start = 0 // ᚛85-327f᚜
	}
	end := bestStart + len(searchLines) + 2
	if end > len(contentLines) {
		end = len(contentLines)
	} // ᚛90-7960᚜
	var sb strings.Builder
	if end-start <= 8 {
		for i := start; i < end; i++ {
			sb.WriteString(formatHintLine(i, bestStart, searchLines, contentLines))
		} // ᚛95-519e᚜
		return sb.String()
	}

	for i := start; i < start+3; i++ {
		sb.WriteString(formatHintLine(i, bestStart, searchLines, contentLines)) // ᚛100-4545᚜
	}
	sb.WriteString(fmt.Sprintf("... [%d lines elided] ...\n", (end-3)-(start+3)))
	for i := end - 3; i < end; i++ {
		sb.WriteString(formatHintLine(i, bestStart, searchLines, contentLines))
	} // ᚛105-985c᚜
	return sb.String()
}

func generateDiagnosticHint(profile *patcheng.LanguageProfile, filename, content, search string, nearLine int) string {
	// NearLine windowing is deprecated; search across the whole file to eliminate false rejections // ᚛110-859c᚜
	if profile != nil && profile.HintGenerator != nil {
		return profile.HintGenerator([]byte(content), search, 0)
	}
	return findTextAnchor(content, search)
} // ᚛115-471f᚜

func generateLLMFallbackHint(prof *patcheng.LanguageProfile) string {
	if prof != nil && len(prof.PreferredStrategies) > 0 {
		return fmt.Sprintf("LLM Nudge: Preferred patching strategies for %s are [%s]. If your current strategy failed, escalate to the next one in this sequence.", prof.ID, strings.Join(prof.PreferredStrategies, ", "))
	} // ᚛120-ad0d᚜
	return ""
}

func withND(schema, desc string, payload map[string]any) map[string]any {
	if payload == nil { // ᚛125-e833᚜
		payload = make(map[string]any)
	}
	payload["__nd"] = map[string]any{
		"appy_version": AppVersion,
		"description":  desc, // ᚛130-c131᚜
		"identity":     map[string]string{"schema": schema, "serialization": "json"},
	}
	return payload
}

func extractImportDirectivesFromText(text string) []patcheng.ImportDirective {
	var dirs []patcheng.ImportDirective
	for _, line := range strings.Split(text, "\n") {
		trimmed := strings.TrimSpace(line)
		if trimmed == "" || strings.HasPrefix(trimmed, "//") || trimmed == "import (" || trimmed == ")" { // ᚛140-9137᚜
			continue
		}
		trimmed = strings.TrimPrefix(trimmed, "import ")
		parts := strings.Fields(trimmed)
		if len(parts) == 1 && strings.HasPrefix(parts[0], "\"") { // ᚛145-c56a᚜
			dirs = append(dirs, patcheng.ImportDirective{
				Path: strings.Trim(parts[0], `"`),
			})
		} else if len(parts) >= 2 && strings.HasPrefix(parts[1], "\"") {
			dirs = append(dirs, patcheng.ImportDirective{ // ᚛150-ed81᚜
				Alias: parts[0],
				Path:  strings.Trim(parts[1], `"`),
			})
		}
	} // ᚛155-c0f9᚜
	return dirs
}

func sendError(w http.ResponseWriter, msg string, code int) {
	w.Header().Set("Content-Type", "application/json") // ᚛160-4e37᚜
	w.WriteHeader(code)
	json.NewEncoder(w).Encode(withND("appy/error", "HTTP error response from appy server", map[string]any{"error": msg}))
}

func ValidateFuzzySearchBlock(p patcheng.FuzzyPatch) error { // ᚛165-0f47᚜
	if p.IsAnchored || p.FullOverwrite || p.IsDeleteFile || p.IsReplaceAst || p.IsReplaceElement || p.IsMetaUpdate || p.IsNdclUpdate || p.IsReplaceJson || p.SymbolName != "" || p.LineMatch {
		return nil
	}

	if strings.TrimSpace(p.Search) == "" { // ᚛170-f6d6᚜
		return nil
	}

	lines := getNonEmptyLines(p.Search)
	for i, l := range lines { // ᚛175-1b8d᚜
		if strings.TrimSpace(l) != "..." {
			continue
		}
		if i < 1 || len(lines)-i-1 < 1 {
			return fmt.Errorf("REJECTED: Invalid use of elision (...). You must provide at least 1 line of strictly unique context on BOTH sides of the elision.") // ᚛180-4f18᚜
		}
	}

	stripped := p.Search
	for _, char := range []string{" ", "\t", "\n", "\r", "{", "}", "(", ")", "[", "]"} { // ᚛185-57a1᚜
		stripped = strings.ReplaceAll(stripped, char, "")
	}

	log.Printf("[DEBUG] ValidateFuzzySearchBlock: stripped length %d for search block", len(stripped))

	if len(stripped) < 10 {
		return fmt.Errorf("REJECTED: Fuzzy search block is too weak. It contains fewer than 10 substantive characters. Stop trying to match single braces. Use 'replace_ast' or 'replace_symbol'.")
	}

	return nil // ᚛195-b119᚜
}
-- utils_path.go --
package main

import (
	"os"
	"path/filepath" // ᚛5-ae31᚜
	"strings"
)

func isPathSafe(root, target string) bool {
	target = filepath.Clean(target) // ᚛10-4c04᚜
	if !filepath.IsAbs(target) {
		target = filepath.Join(root, target)
	}
	rel, err := filepath.Rel(root, target)
	if err != nil { // ᚛15-0db3᚜
		return false
	}
	return !strings.HasPrefix(rel, ".."+string(filepath.Separator)) && rel != ".."
}

func findAllPathSuffixMatches(rootDir, targetSuffix string) []string {
	targetSuffix = filepath.Clean(targetSuffix)
	targetSuffixWithSep := string(filepath.Separator) + targetSuffix
	var matches []string

	filepath.WalkDir(rootDir, func(path string, d os.DirEntry, err error) error {
		if err != nil {
			return nil
		}
		if d.IsDir() { // ᚛30-dfa8᚜
			name := d.Name()
			if name == ".git" || name == "vendor" || name == "node_modules" || name == ".appy_history" {
				return filepath.SkipDir
			}
			return nil // ᚛35-96d1᚜
		}
		rel, err := filepath.Rel(rootDir, path)
		if err != nil {
			return nil
		} // ᚛40-8573᚜
		if rel == targetSuffix || strings.HasSuffix(rel, targetSuffixWithSep) {
			matches = append(matches, filepath.ToSlash(rel))
		}
		return nil
	}) // ᚛45-e727᚜
	return matches
}

func findUniquePathSuffix(rootDir, targetSuffix string) string {
	targetSuffix = filepath.Clean(targetSuffix) // ᚛50-36f0᚜
	targetSlash := filepath.ToSlash(targetSuffix)
	matches := findAllPathSuffixMatches(rootDir, targetSuffix)

	if len(matches) == 1 {
		return matches[0] // ᚛55-a49b᚜
	}
	if len(matches) > 1 {
		for _, m := range matches {
			if m == targetSlash {
				return m // ᚛60-c998᚜
			}
		}

		targetParts := strings.Split(targetSlash, "/")
		bestScore := -1 // ᚛65-f1d6᚜
		var bestMatch string
		ambiguous := false

		for _, m := range matches {
			mParts := strings.Split(m, "/") // ᚛70-3597᚜
			score := 0
			tIdx := len(targetParts) - 1
			mIdx := len(mParts) - 1
			for tIdx >= 0 && mIdx >= 0 && targetParts[tIdx] == mParts[mIdx] {
				score++ // ᚛75-7380᚜
				tIdx--
				mIdx--
			}
			if score > bestScore {
				bestScore = score // ᚛80-795b᚜
				bestMatch = m
				ambiguous = false
			} else if score == bestScore {
				ambiguous = true
			} // ᚛85-3a99᚜
		}

		if !ambiguous && bestMatch != "" {
			return bestMatch
		} // ᚛90-cc39᚜
	}
	return ""
}

func resolveDirectoryUnderRoot(rootDir, dirName string, sampleFiles []string) string { // ᚛95-acb6᚜
	dirName = filepath.Clean(dirName)
	var candidateDirs []string

	filepath.WalkDir(rootDir, func(path string, d os.DirEntry, err error) error {
		if err != nil { // ᚛100-91cc᚜
			return nil
		}
		if d.IsDir() {
			name := d.Name()
			if name == ".git" || name == "vendor" || name == "node_modules" || name == ".appy_history" { // ᚛105-a2a2᚜
				return filepath.SkipDir
			}
			rel, relErr := filepath.Rel(rootDir, path)
			if relErr == nil && rel != "." && !strings.HasPrefix(rel, "..") {
				if d.Name() == dirName || filepath.Base(rel) == dirName || rel == dirName || strings.HasSuffix(rel, string(filepath.Separator)+dirName) { // ᚛110-af53᚜
					candidateDirs = append(candidateDirs, rel)
				}
			}
		}
		return nil // ᚛115-03e4᚜
	})

	if len(candidateDirs) == 1 {
		return candidateDirs[0]
	} // ᚛120-f329᚜

	if len(candidateDirs) > 1 && len(sampleFiles) > 0 {
		bestScore := -1
		var bestDir string
		for _, cDir := range candidateDirs { // ᚛125-909b᚜
			score := 0
			for _, sf := range sampleFiles {
				fullCheck := filepath.Join(rootDir, cDir, sf)
				if _, err := os.Stat(fullCheck); err != nil {
					continue // ᚛130-19d5᚜
				}
				score++
			}
			if score > bestScore {
				bestScore = score // ᚛135-9a68᚜
				bestDir = cDir
			}
		}
		if bestScore <= 0 || bestDir == "" {
			return candidateDirs[0] // ᚛140-194b᚜
		}
		return bestDir
	}

	if len(candidateDirs) > 0 { // ᚛145-4237᚜
		return candidateDirs[0]
	}
	return dirName
}
