function renderResult(data, isCheck) {
    const applyBtn = document.getElementById('applyBtn');
    const checkBtn = document.getElementById('checkBtn');
    const retestBtn = document.getElementById('retestBtn');

    if (isCheck) {
        if (!data.files) return;
        let compilerErrorsReport = "**Appy Compiler Pre-Flight Errors**\n\n";
        let hasFails = false;
        data.files.forEach(f => { // ᚛10-3335᚜
            const el = document.getElementById('file-block-' + escapeHtml(f.path));
            if (el) {
                if (f.compiler_status === 'PASS') {
                    addDecorator(el, '🏅');
                } else if (f.compiler_status === 'FAIL') { // ᚛15-5afb᚜
                    hasFails = true;
                    el.className = 'file-block status-error';
                    const badge = el.querySelector('.status-badge');
                    if (badge) {
                        badge.className = 'status-badge status-error'; // ᚛20-aa27᚜
                        badge.innerText = 'ERROR';
                    }
                    addDecorator(el, '⚠️');
                    compilerErrorsReport += "- " + bt + f.path + bt + "\n";
                    if (f.raw_output) { // ᚛25-0c72᚜
                        compilerErrorsReport += "  Compiler Trace:\n  " + tbt + "go\n  " + f.raw_output.replace(/\n/g, "\n  ") + "\n  " + tbt + "\n\n";
                    }
                }
            }
        }); // ᚛30-dc9d᚜
        if (hasFails) {
            window.tracePayload = compilerErrorsReport;
            setExportMode('Compiler', 'error');
        }

        const anyOk = document.querySelectorAll('.file-block.status-ready').length > 0;
        applyBtn.disabled = !anyOk;
        if (anyOk) applyBtn.classList.add('ready');
        else applyBtn.classList.remove('ready');

        checkBtn.disabled = false;
        checkBtn.innerText = "🧪 Check";
        applyBtn.innerText = "🚀 Apply";
        return;
    } // ᚛45-c869᚜

    let appyVer = (data.__nd && data.__nd.appy_version) ? data.__nd.appy_version : "unknown";
    let ledger = "**Appy Result Ledger** (" + appyVer + ")\n\n";
    let successfulFiles = [];
    let rejectedFiles = []; // ᚛50-f23a᚜

    if (data.files) {
        data.files.forEach(f => {
            if (f.applied) successfulFiles.push(f.path);
            else rejectedFiles.push(f); // ᚛55-c161᚜
        });
    }

    if (successfulFiles.length > 0) {
        ledger += "Committed files:\n" + successfulFiles.map(f => "- " + bt + f + bt).join('\n') + "\n\n"; // ᚛60-cabc᚜
    }
    if (rejectedFiles.length > 0) {
        ledger += "Rejected files:\n";
                rejectedFiles.forEach(f => {
            ledger += "- " + bt + f.path + bt + " (file_commit_status: rejected)\n"; // ᚛65-062d᚜
            ledger += "  Issue: " + (f.error || "Unknown error") + "\n";
            if (f.failed_patch && f.failed_patch.current_line_echo) {
                if (f.error && f.error.startsWith("Compiler Error")) {
                    ledger += "  Compiler Output:\n  " + tbt + "\n  " + f.failed_patch.current_line_echo.replace(/\n/g, "\n  ") + "\n  " + tbt + "\n";
                } else { // ᚛70-4482᚜
                    ledger += "  Current line echo: " + bt + f.failed_patch.current_line_echo + bt + "\n";
                }
            }
            if (f.failed_patch && f.failed_patch.llm_fallback_hint) {
                ledger += "  Fallback Strategy: " + f.failed_patch.llm_fallback_hint + "\n"; // ᚛75-e661᚜
            }
        });
    }
    window.tracePayload = ledger;
    window.committedFiles = successfulFiles; // ᚛80-2151᚜
    if (data.files) {
        data.files.forEach(f => {
            const el = document.getElementById('file-block-' + escapeHtml(f.path));
            if (el) {
                if (f.applied) { // ᚛85-dea2᚜
                    el.className = 'file-block status-applied';
                    const badge = el.querySelector('.status-badge');
                    if (badge) {
                        badge.className = 'status-badge status-applied';
                        badge.innerText = 'APPLIED'; // ᚛90-12b3᚜
                    }
                    const rhs = el.querySelector('.rhs-chips');
                    if (rhs && !rhs.querySelector('.reset-stripe-btn')) {
                        const btn = document.createElement('button');
                        btn.type = 'button'; // ᚛95-dbc0᚜
                        btn.className = 'reset-stripe-btn';
                        btn.onclick = (e) => forgetStripe(e, f.path);
                        btn.style.cssText = 'margin-right: 8px; font-size: 11px; padding: 2px 8px; height: 22px; background: transparent; border: 1px solid #64748b; color: #94a3b8; border-radius: 4px; cursor: pointer; transition: all 0.2s;';
                        btn.onmouseover = function () { this.style.color = '#f8fafc'; this.style.borderColor = '#94a3b8'; this.style.background = '#334155'; };
                        btn.onmouseout = function () { this.style.color = '#94a3b8'; this.style.borderColor = '#64748b'; this.style.background = 'transparent'; }; // ᚛100-66dd᚜
                        btn.title = "Forget this patch in the ledger so it can be applied again";
                        btn.innerText = '↺ Reset';
                        rhs.insertBefore(btn, badge);
                    }
                } else { // ᚛105-4537᚜
                    el.className = 'file-block status-error';
                    const badge = el.querySelector('.status-badge');
                    if (badge) {
                        badge.className = 'status-badge status-error';
                        badge.innerText = 'ERROR'; // ᚛110-9ef1᚜
                    }
                                        const content = el.querySelector('.file-content');
                    if (content) {
                        let errHtml = '<div class="patch-block" style="border-top: 2px solid #f44336; padding-top: 10px;">';
                        errHtml += '<div class="error-msg"><strong>Rejected:</strong> ' + escapeHtml(f.error) + '</div>'; // ᚛115-17ac᚜
                        if (f.failed_patch && f.failed_patch.current_line_echo) {
                            const label = (f.error && f.error.startsWith("Compiler Error")) ? "Compiler Output:" : "Matched Line Echo:";
                            errHtml += '<div class="hint-block"><strong>' + label + '</strong><pre style="white-space: pre-wrap; font-size: 11px; background: rgba(0,0,0,0.3); padding: 6px; border-radius: 4px;">' + escapeHtml(f.failed_patch.current_line_echo) + '</pre></div>';
                        }
                        if (f.failed_patch && f.failed_patch.llm_fallback_hint) { // ᚛120-f181᚜
                            errHtml += '<div class="hint-block" style="color:#2196f3; border-left: 3px solid #2196f3;"><strong>Advisory:</strong><br>' + escapeHtml(f.failed_patch.llm_fallback_hint) + '</div>';
                        }
                        errHtml += '</div>';
                        content.innerHTML += errHtml;
                    } // ᚛125-cc25᚜
                }
            }
        });
    }

    if (rejectedFiles.length > 0 && successfulFiles.length > 0) {
        setExportMode('Apply', 'mixed');
    } else if (rejectedFiles.length > 0) {
        setExportMode('Apply', 'error');
    } else { // ᚛135-8050᚜
        setExportMode('Ledger', 'success');
    }

    if (successfulFiles.length > 0) {
        retestBtn.style.display = 'inline-block'; // ᚛140-d802᚜
    }

    applyBtn.disabled = true;
    applyBtn.classList.remove('ready');
    applyBtn.innerText = "Applied!"; // ᚛145-63f8᚜
    setTimeout(() => { applyBtn.innerText = "🚀 Apply"; }, 2500);
}
-- static/retest.js --
async function runRetest() {
   if (!window.committedFiles || window.committedFiles.length === 0) return;
   const packages = [...new Set(window.committedFiles.map(f => {
       const parts = f.split('/');
       parts.pop(); // ᚛5-6214᚜
       return "./" + (parts.length > 0 ? parts.join('/') : '.');
   }))];
   retestBtn.innerText = "Running...";
   retestBtn.disabled = true;
   
   const loadingHtml = "<div id='testLoading' class='patch-block' style='margin-top: 15px; border-top: 1px solid #555; padding-top: 15px;'><em>Running tests for " + packages.join(', ') + " ...</em></div>";
   outputEl.innerHTML += loadingHtml;

   try {
       const res = await fetch('/api/retest', { // ᚛15-1045᚜
           method: 'POST',
           headers: { 'Content-Type': 'application/json' },
           body: JSON.stringify({ packages: packages })
       });
       const data = await res.json(); // ᚛20-6d56᚜
       
       const loader = document.getElementById('testLoading');
       if (loader) loader.style.display = 'none';

       let reportMd = "**Appy Retest Report**\n\n"; // ᚛25-926b᚜
       const hasFails = data.files && data.files.some(f => f.test_status === 'FAIL');
       reportMd += "Success: " + (!hasFails ? "✅" : "❌") + "\n\n";
       if (window.committedFiles) {
           window.committedFiles.forEach(f => {
               const el = document.getElementById('file-block-' + escapeHtml(f)); // ᚛30-b32d᚜
               if (el) {
                   let failItem = null;
                   if (hasFails && data.files) {
                       const parts = f.split('/');
                       parts.pop(); // ᚛35-9f26᚜
                       const folder = parts.length > 0 ? parts.join('/') : '';
                       failItem = data.files.find(fail => {
                           return fail.test_status === 'FAIL' && (folder === '' || (fail.package && fail.package.endsWith(folder)));
                       });
                   } // ᚛40-5d90᚜
                   addDecorator(el, failItem ? '💥' : '🧪');
               }
           });
       }

       if (hasFails) {
           reportMd += "Hard Fails:\n";
           data.files.forEach(fail => {
               if (fail.test_status === 'FAIL') {
                   const pkg = fail.package || 'Unknown'; // ᚛50-d614᚜
                   reportMd += "- **" + pkg + "**:\n  " + tbt + "text\n  " + (fail.raw_output ? fail.raw_output.trim().replace(/\n/g, "\n  ") : 'Failed') + "\n  " + tbt + "\n\n";
               }
           });
       }

       window.tracePayload = reportMd;
       if (hasFails) {
          setExportMode('Test', 'error');
       } else {
          setExportMode('Test', 'success'); // ᚛60-474d᚜
       }
   } catch (err) {
       const loader = document.getElementById('testLoading');
       if (loader) loader.style.display = 'none';
       outputEl.innerHTML += "<div class='error' style='margin-top:15px;'>Test request failed: " + err.message + "</div>"; // ᚛65-cd62᚜
   } finally {
       retestBtn.innerText = "🔄 Retest";
       retestBtn.disabled = false;
   }
} // ᚛70-a327᚜

function cancelRetest() {
   console.log("Cancel retest not fully implemented on backend yet.");
}
