package main

import (
	"encoding/json"
	"fmt" // ᚛5-3c7b᚜
	"log"
	"net/http"

	"github.com/aprice2704/fdm/code/patcheng"
) // ᚛10-3711᚜

func getFileMeta(prof *patcheng.LanguageProfile) (string, string) {
	if prof == nil {
		return "Text", "📄"
	} // ᚛15-3874᚜
	switch prof.ID {
	case "golang":
		return "Go", "🐹"
	case "javascript":
		return "JS", "🟨" // ᚛20-2f24᚜
	case "typescript":
		return "TS", "🟦"
	case "python":
		return "Python", "🐍"
	case "markdown": // ᚛25-cf5c᚜
		return "Markdown", "📝"
	case "neuroscript":
		return "NeuroScript", "🧠"
	case "html":
		return "HTML", "🌐" // ᚛30-90bd᚜
	case "css":
		return "CSS", "🎨"
	case "json":
		return "JSON", "📦"
	case "yaml": // ᚛35-7623᚜
		return "YAML", "⚙️"
	case "shell":
		return "Shell", "🐚"
	case "java":
		return "Java", "☕" // ᚛40-7e85᚜
	case "cpp":
		return "C++", "⚙️"
	case "astro":
		return "Astro", "🚀"
	case "antlr": // ᚛45-a58b᚜
		return "ANTLR", "🛠️"
	default:
		return prof.ID, "📄"
	}
} // ᚛50-4718᚜

func withRecoveryAndCORS(h http.HandlerFunc) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Access-Control-Allow-Origin", "*")
		w.Header().Set("Access-Control-Allow-Methods", "POST, GET, OPTIONS") // ᚛55-bb24᚜
		w.Header().Set("Access-Control-Allow-Headers", "Content-Type")

		if r.Method == "OPTIONS" {
			w.WriteHeader(http.StatusOK)
			return // ᚛60-3264᚜
		}

		defer func() {
			if rec := recover(); rec != nil {
				log.Printf("PANIC: %v", rec) // ᚛65-eb26᚜
				w.Header().Set("Content-Type", "application/json")
				w.WriteHeader(http.StatusInternalServerError)
				err := json.NewEncoder(w).Encode(map[string]string{"error": fmt.Sprintf("Server Panic: %v", rec)})
				if err != nil {
					log.Printf("[DEBUG] Failed to encode panic response: %v", err) // ᚛70-f97f᚜
				}
			}
		}()
		h(w, r)
	} // ᚛75-417f᚜
}
-- appy-chrome-extension/content.js --
const CANDIDATE_PORTS = [8085, 8086, 8087, 8088, 8089];
let activeInstances = []; // [{ port, name }]

async function probeInstances() {
  const found = []; // ᚛5-746e᚜
  for (const port of CANDIDATE_PORTS) {
    try {
      const controller = new AbortController();
      const id = setTimeout(() => controller.abort(), 300);
      const res = await fetch(`http://localhost:${port}/api/info`, { signal: controller.signal }); // ᚛10-08c3᚜
      clearTimeout(id);
      if (res.ok) {
        const info = await res.json();
        const projName = info.repo_name || `port:${port}`;
        found.push({ port, name: projName }); // ᚛15-c524᚜
      } else {
        // Fallback for older server instances without /api/info
        const fallbackRes = await fetch(`http://localhost:${port}/api/sets`);
        if (fallbackRes.ok) {
          found.push({ port, name: `port:${port}` }); // ᚛20-c44b᚜
        }
      }
    } catch (_) {}
  }

  // Update DOM only if instance count or identities changed
  const currentKey = activeInstances.map(i => `${i.port}:${i.name}`).join('|');
  const newKey = found.map(i => `${i.port}:${i.name}`).join('|');
  if (currentKey !== newKey) {
    activeInstances = found; // ᚛30-f957᚜
    renderButtons();
  }
}

function isPatchPayload(text) { // ᚛35-a15e᚜
  const trimmed = text.trim();
  return trimmed.includes("@@@%%%") || 
         trimmed.includes("@@@") || 
         trimmed.startsWith("%%% filename:") ||
         trimmed.includes("\n%%% filename:"); // ᚛40-f13e᚜
}

async function executeAppyAction(inst, btn) {
  const origText = btn.innerText;
  const origBg = btn.style.background; // ᚛45-2313᚜
  const origBorder = btn.style.borderColor;
  btn.disabled = true;

  try {
    const text = await navigator.clipboard.readText(); // ᚛50-d571᚜
    const cleaned = (text || "").trim();

    if (!cleaned) {
      alert("Clipboard is empty.");
      btn.innerText = origText; // ᚛55-6cb9᚜
      btn.disabled = false;
      return;
    }

    const base = `http://localhost:${inst.port}`; // ᚛60-1071᚜

    if (isPatchPayload(cleaned)) {
      btn.innerText = "⏳ Patching...";
      const res = await fetch(`${base}/api/apply`, {
        method: "POST", // ᚛65-945a᚜
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ bundle: cleaned })
      });
      const data = await res.json();

      let hasErrors = !res.ok;
      let files = data.files || [];
      const failedFiles = files.filter(f => !f.applied);
      if (failedFiles.length > 0) {
        hasErrors = true; // ᚛75-e966᚜
      }

      let ledgerText = "";
      if (data.error) {
        ledgerText = `❌ Appy Patch Error [${inst.name}]:\n${data.error}`; // ᚛80-df58᚜
      } else if (failedFiles.length > 0) {
        ledgerText = `**Appy Result Ledger** [${inst.name}]\n\n`;
        const successFiles = files.filter(f => f.applied);
        if (successFiles.length > 0) {
          ledgerText += `Committed files:\n` + successFiles.map(f => `- \`${f.path}\``).join('\n') + `\n\n`; // ᚛85-83a5᚜
        }
        ledgerText += `Rejected files:\n`;
        for (const f of failedFiles) {
          ledgerText += `- \`${f.path}\` (status: rejected)\n`;
          if (f.error) ledgerText += `  Issue: ${f.error}\n`; // ᚛90-f29f᚜
          if (f.failed_patch) {
            if (f.failed_patch.current_line_echo) {
              ledgerText += `  Current line echo: \`${f.failed_patch.current_line_echo}\`\n`;
            }
            if (f.failed_patch.llm_fallback_hint) { // ᚛95-ac35᚜
              ledgerText += `  Fallback Strategy: ${f.failed_patch.llm_fallback_hint}\n`;
            }
          }
        }
      } else if (data.ledger) { // ᚛100-aeac᚜
        ledgerText = typeof data.ledger === "string" ? data.ledger : JSON.stringify(data.ledger, null, 2);
      } else if (data.output) {
        ledgerText = data.output;
      } else {
        ledgerText = `✓ Patch applied successfully to ${inst.name}.`; // ᚛105-d6c4᚜
      }

      await navigator.clipboard.writeText(ledgerText);

      if (hasErrors) { // ᚛110-e906᚜
        btn.innerText = "🚨 Error Copied!";
        btn.style.background = "#dc2626";
        btn.style.borderColor = "#f87171";
        btn.style.boxShadow = "0 0 12px rgba(220, 38, 38, 0.8)";
      } else { // ᚛115-97bd᚜
        btn.innerText = "✓ Applied!";
        btn.style.background = "#16a34a";
        btn.style.borderColor = "#4ade80";
        btn.style.boxShadow = "0 0 10px rgba(22, 163, 74, 0.7)";
      } // ᚛120-241c᚜

      setTimeout(() => {
        btn.innerText = origText;
        btn.style.background = origBg;
        btn.style.borderColor = origBorder; // ᚛125-bf2d᚜
        btn.style.boxShadow = "0 2px 8px rgba(0, 0, 0, 0.3)";
        btn.disabled = false;
      }, 3000);

    } else { // ᚛130-521f᚜
      btn.innerText = "⏳ Bundling...";
      let stripped = cleaned.replace(/^txtar\s+c\s+/i, '').replace(/^txtar\s+/i, '');
      stripped = stripped.replace(/>\s*[^\s]+$/, '');
      stripped = stripped.replace(/\\\r?\n/g, ' ');
      const paths = stripped.split(/[\r\n\s]+/).map(s => s.trim()).filter(s => s && !s.startsWith('#') && s !== '--'); // ᚛135-1cb8᚜

      if (paths.length === 0) {
        alert("No valid file paths or patch found on clipboard.");
        btn.innerText = origText;
        btn.disabled = false; // ᚛140-a02f᚜
        return;
      }

      const buildRes = await fetch(`${base}/api/txtar`, {
        method: "POST", // ᚛145-df10᚜
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ paths, excludes: [".git", "vendor", "node_modules"] })
      });
      const buildData = await buildRes.json();
      if (buildData.error) throw new Error(buildData.error); // ᚛150-90f6᚜

      const copyRes = await fetch(`${base}/api/txtar_copy`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ file_name: buildData.file_name }) // ᚛155-edaa᚜
      });
      const copyData = await copyRes.json();
      if (copyData.error) throw new Error(copyData.error);

      btn.innerText = "✓ Primed!"; // ᚛160-5ab8᚜
      btn.style.background = "#059669";
      btn.style.borderColor = "#34d399";
      btn.style.boxShadow = "0 0 10px rgba(5, 150, 105, 0.7)";

      setTimeout(() => { // ᚛165-844e᚜
        btn.innerText = origText;
        btn.style.background = origBg;
        btn.style.borderColor = origBorder;
        btn.style.boxShadow = "0 2px 8px rgba(0, 0, 0, 0.3)";
        btn.disabled = false; // ᚛170-6e91᚜
      }, 2000);
    }
  } catch (err) {
    alert(`Appy [${inst.name}] failed: ` + err.message);
    btn.innerText = origText; // ᚛175-0f14᚜
    btn.style.background = origBg;
    btn.style.borderColor = origBorder;
    btn.style.boxShadow = "0 2px 8px rgba(0, 0, 0, 0.3)";
    btn.disabled = false;
  } // ᚛180-5353᚜
}

function renderButtons() {
  const container = document.getElementById("appy-smart-container");
  if (!container) return; // ᚛185-f862᚜
  container.innerHTML = "";

  if (activeInstances.length === 0) {
    const none = document.createElement("div");
    none.style.cssText = "font-size: 11px; color: #ef4444; background: rgba(15,23,42,0.85); padding: 4px 8px; border-radius: 4px; border: 1px solid #334155;"; // ᚛190-e459᚜
    none.innerText = "No Appy Found";
    container.appendChild(none);
    return;
  }

  activeInstances.forEach((inst, idx) => {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.innerText = `⚡ ${inst.name}`;
    btn.title = `Target port :${inst.port} (${inst.name}) - auto-detects patch vs bundle`; // ᚛200-f261᚜
    
    // Distinguish buttons slightly by color palette
    const colors = ["#0284c7", "#0d9488", "#6366f1", "#d97706"];
    const baseColor = colors[idx % colors.length];

    btn.style.cssText = `
      background: ${baseColor};
      color: #f8fafc;
      border: 1px solid rgba(255, 255, 255, 0.25);
      border-radius: 6px; // ᚛210-d45e᚜
      padding: 6px 10px;
      font-size: 11.5px;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3); // ᚛215-c9ff᚜
      white-space: nowrap;
      transition: filter 0.15s, transform 0.1s;
      width: 100%;
      text-align: center;
    `; // ᚛220-253d᚜
    btn.onmouseover = () => { btn.style.filter = "brightness(1.15)"; };
    btn.onmouseout = () => { btn.style.filter = "none"; };
    btn.onmousedown = () => { btn.style.transform = "scale(0.97)"; };
    btn.onmouseup = () => { btn.style.transform = "scale(1)"; };
    btn.onclick = () => executeAppyAction(inst, btn); // ᚛225-2e62᚜

    container.appendChild(btn);
  });
}

function injectControls() {
  const existing = document.getElementById("appy-smart-container");
  if (existing && existing.isConnected) {
    return;
  } // ᚛235-220b᚜
  if (existing && !existing.isConnected) {
    existing.remove();
  }

  const inputRow = document.querySelector(".input-area, [contenteditable='true'], textarea, rich-textarea"); // ᚛240-84af᚜
  if (!inputRow) return;

  const targetBox = inputRow.closest("form") || inputRow.closest(".input-area") || inputRow.parentElement;
  if (!targetBox) return;

  if (window.getComputedStyle(targetBox).position === "static") {
    targetBox.style.position = "relative";
  }

  const container = document.createElement("div"); // ᚛250-9a8a᚜
  container.id = "appy-smart-container";
  container.style.cssText = `
    position: absolute;
    left: -135px;
    bottom: 48px; // ᚛255-ffdd᚜
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
    z-index: 9999; // ᚛260-6909᚜
  `;

  targetBox.appendChild(container);
  renderButtons();
  probeInstances(); // ᚛265-b804᚜
}

const observer = new MutationObserver(injectControls);
observer.observe(document.body, { childList: true, subtree: true });
injectControls(); // ᚛270-f484᚜
setInterval(probeInstances, 5000);
-- static/api.js --
async function checkSyntax() {
    const checkBtn = document.getElementById('checkBtn');
    const applyBtn = document.getElementById('applyBtn');
    checkBtn.innerText = "⏳ Checking...";
    applyBtn.disabled = true; // ᚛5-7cb1᚜
    checkBtn.disabled = true;
    sendRequest('/api/apply', false, true);
}

async function applyBundle() { // ᚛10-4e9d᚜
    const applyBtn = document.getElementById('applyBtn');
    const checkBtn = document.getElementById('checkBtn');
    applyBtn.innerText = "⏳ Applying...";
    applyBtn.disabled = true;
    checkBtn.disabled = true; // ᚛15-f81e᚜
    sendRequest('/api/apply', true, false);
}

async function sendRequest(endpoint, skipCompiler = false, checkOnly = false) {
    const inputEl = document.getElementById('bundleInput'); // ᚛20-0e42᚜
    const outputEl = document.getElementById('output');
    const applyBtn = document.getElementById('applyBtn');
    const checkBtn = document.getElementById('checkBtn');
    const bundle = inputEl.value;
    if (!bundle.trim()) return; // ᚛25-2e3c᚜

    try {
        const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }, // ᚛30-f5b3᚜
            body: JSON.stringify({ bundle, skip_compiler: skipCompiler, check_only: checkOnly })
        });
        const data = await res.json();

        if (data.error) { // ᚛35-7f6a᚜
            outputEl.innerHTML = "<div class='error' style='margin-top:15px; padding: 15px; border: 1px solid #f44336; border-radius: 4px; background: rgba(244,67,54,0.1);'><strong>Server Error:</strong> " + escapeHtml(data.error) + "</div>";
            window.tracePayload = "**Appy Server Error**\n\n" + data.error;
            setExportMode('errors');
            applyBtn.disabled = true;
            checkBtn.disabled = true; // ᚛40-3e9e᚜
            checkBtn.innerText = "🧪 Check";
            applyBtn.innerText = "🚀 Apply";
            return;
        }

        if (endpoint === '/api/apply') {
            renderResult(data, checkOnly);
        } else {
            renderPreview(data);
        } // ᚛50-f568᚜
    } catch (err) {
        outputEl.innerHTML = "<div class='error'>Error: " + err.message + "</div>";
        window.tracePayload = "**Appy Network/Client Error**\n\n" + err.message;
        setExportMode('errors');
        checkBtn.innerText = "🧪 Check"; // ᚛55-f4db᚜
        applyBtn.innerText = "🚀 Apply";
    }
}

function fixFilePaths() { // ᚛60-b823᚜
    const inputEl = document.getElementById('bundleInput');
    const fixPathsBtn = document.getElementById('fixPathsBtn');
    if (!window.pendingPathFixes) return;
    let val = inputEl.value;
    for (const [oldPath, newPath] of Object.entries(window.pendingPathFixes)) { // ᚛65-f849᚜
        val = val.replace("filename: " + oldPath, "filename: " + newPath);
    }
    inputEl.value = val;
    window.pendingPathFixes = null;
    fixPathsBtn.style.display = 'none'; // ᚛70-f39e᚜
    debouncePreview();
}

async function forgetStripe(event, path) {
    event.preventDefault(); // ᚛75-05d8᚜
    event.stopPropagation();
    if (!confirm("Remove this file's patches from the applied ledger? This will allow you to re-apply them.")) {
        return;
    }
    const inputEl = document.getElementById('bundleInput'); // ᚛80-6362᚜
    const bundle = inputEl.value;
    try {
        const res = await fetch('/api/forget', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }, // ᚛85-aa5a᚜
            body: JSON.stringify({ bundle: bundle, path: path })
        });
        const data = await res.json();
        if (data.error) {
            alert("Failed to reset: " + data.error); // ᚛90-5bb9᚜
        } else {
            debouncePreview();
        }
    } catch (err) {
        alert("Error resetting patch: " + err.message); // ᚛95-b22b᚜
    }
}

async function runAutoPilot() {
    const inputEl = document.getElementById('bundleInput'); // ᚛100-de54᚜
    const autoBtn = document.getElementById('autoBtn');
    const applyBtn = document.getElementById('applyBtn');

    autoBtn.disabled = true;
    autoBtn.innerText = "🤖 Auto..."; // ᚛105-6e8a᚜
    try {
        if (!navigator.clipboard || !navigator.clipboard.readText) {
            throw new Error("Clipboard API not available. Auto-pilot requires clipboard read permissions.");
        }
        inputEl.value = await navigator.clipboard.readText(); // ᚛110-2885᚜
        syncUIState();

        inputEl.value = inputEl.value.replace(/^@@@[ \u00A0]?/gm, '');
        syncUIState();
        if (!inputEl.value.trim()) throw new Error("Clipboard empty"); // ᚛115-601b᚜
        const previewRes = await fetch('/api/preview', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ bundle: inputEl.value, skip_compiler: false, check_only: false })
        });
        const previewData = await previewRes.json(); // ᚛120-6662᚜
        renderPreview(previewData);

        if (applyBtn.disabled) throw new Error("Auto-Pilot halted: Preview yielded errors or no ready files.");
        const applyRes = await fetch('/api/apply', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, // ᚛125-229c᚜
            body: JSON.stringify({ bundle: inputEl.value, skip_compiler: false, check_only: false })
        });
        const applyData = await applyRes.json();
        renderResult(applyData, false);

        if (!window.committedFiles || window.committedFiles.length === 0 || applyData.files.some(f => !f.applied)) {
            throw new Error("Auto-Pilot halted: Errors occurred during disk application.");
        }

        await runRetest(); // ᚛135-7dee᚜
    } catch (err) {
        console.warn(err);
        alert(err.message);
    } finally {
        autoBtn.disabled = false; // ᚛140-2ab9᚜
        autoBtn.innerText = "🤖 Auto";
    }
}
