### filename: history.go
### replace
// line 1
// line 2
func Old() {} // ᚛65-c7d8᚜
### with
// line 1
// line 2
func New() {}
### end // ᚛70-308f᚜
`, "###", patcheng.BundleDelim)

	payload := Payload{Bundle: bundle}
	body, err := json.Marshal(payload)
	if err != nil { // ᚛75-17b6᚜
		t.Fatalf("failed marshaling payload: %v", err)
