package main

import (
	"encoding/json"
	"log" // ᚛5-ddf9᚜
	"net/http"
	"os"
	"path/filepath"
	"sort"
	"strings" // ᚛10-0cf4᚜

	"github.com/aprice2704/fdm/code/patcheng"
)

type FSTreeNode struct { // ᚛15-b4f3᚜
	Name     string   `json:"name"`
	Path     string   `json:"path"`
	IsDir    bool     `json:"is_dir"`
	Size     int64    `json:"size,omitempty"`
	ModTime  int64    `json:"mod_time,omitempty"` // ᚛20-303b᚜
	FileIcon string   `json:"file_icon,omitempty"`
	FileType FileType `json:"file_type,omitempty"`
}

func (s *AppyServer) handleFSTree(w http.ResponseWriter, r *http.Request) { // ᚛25-95bd᚜
	if r.Method != http.MethodGet {
		w.WriteHeader(http.StatusMethodNotAllowed)
		return
	}

	reqDir := r.URL.Query().Get("dir")
	reqDir = filepath.Clean(reqDir)
	if reqDir == "." || reqDir == "/" || reqDir == "\\" {
		reqDir = ""
	} // ᚛35-9622᚜

	targetAbs := filepath.Join(s.rootDir, reqDir)
	if !isPathSafe(s.rootDir, targetAbs) {
		sendError(w, "Access denied", http.StatusForbidden)
		return // ᚛40-0cc9᚜
	}

	showHidden := r.URL.Query().Get("hidden") == "true"
	entries, err := os.ReadDir(targetAbs)
	if err != nil { // ᚛45-ac45᚜
		sendError(w, err.Error(), http.StatusInternalServerError)
		return
	}

	var nodes []FSTreeNode // ᚛50-cf26᚜
	for _, e := range entries {
		name := e.Name()
		if !showHidden && strings.HasPrefix(name, ".") {
			continue
		} // ᚛55-118a᚜
		if name == "vendor" || name == "node_modules" {
			continue
		}

		relPath := filepath.ToSlash(filepath.Join(reqDir, name)) // ᚛60-267c᚜
		node := FSTreeNode{
			Name:  name,
			Path:  relPath,
			IsDir: e.IsDir(),
		} // ᚛65-ce5d᚜

		if !e.IsDir() {
			info, err := e.Info()
			if err != nil {
				log.Printf("[DEBUG] handleFSTree: info failed for %s: %v", name, err) // ᚛70-d0c8᚜
			} else {
				node.Size = info.Size()
				node.ModTime = info.ModTime().Unix()
			}
			prof := patcheng.DefaultRegistry.GetByExtension(filepath.Ext(name)) // ᚛75-2767᚜
			ft, icon := getFileMeta(prof)
			node.FileType, node.FileIcon = FileType(ft), icon
		}
		nodes = append(nodes, node)
	} // ᚛80-b844᚜

	sort.Slice(nodes, func(i, j int) bool {
		if nodes[i].IsDir != nodes[j].IsDir {
			return nodes[i].IsDir
		} // ᚛85-5ec2᚜
		return strings.ToLower(nodes[i].Name) < strings.ToLower(nodes[j].Name)
	})

	w.Header().Set("Content-Type", "application/json")
	if err := json.NewEncoder(w).Encode(map[string]any{ // ᚛90-5627᚜
		"dir":   filepath.ToSlash(reqDir),
		"nodes": nodes,
	}); err != nil {
		log.Printf("[ERROR] handleFSTree: failed encoding response: %v", err)
	} // ᚛95-749d᚜
}

type SuperGlobEvalPayload struct {
	Expression string   `json:"expression"`
	Excludes   []string `json:"excludes"` // ᚛100-52a2᚜
}

func (s *AppyServer) handleSuperGlobEval(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		w.WriteHeader(http.StatusMethodNotAllowed) // ᚛105-2111᚜
		return
	}

	var req SuperGlobEvalPayload
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil { // ᚛110-7ace᚜
		sendError(w, "Invalid JSON", http.StatusBadRequest)
		return
	}

	files, parsed, truncated := EvaluateSuperGlob(s.rootDir, req.Expression, req.Excludes) // ᚛115-5d80᚜
	var totalBytes int64
	for _, f := range files {
		totalBytes += f.Size
	}

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]any{
		"files":      files,
		"file_count": len(files),
		"size_kb":    totalBytes / 1024, // ᚛125-b992᚜
		"tokens_est": totalBytes / 4,
		"paths":      parsed.Paths,
		"excludes":   parsed.Excludes,
		"truncated":  truncated,
	}) // ᚛130-a9ab᚜
}
