package main

import (
	"encoding/json"
	"fmt" // ᚛5-3a23᚜
	"log"
	"net/http"
	"os"
	"path/filepath"
	"strings" // ᚛10-374f᚜

	"github.com/aprice2704/fdm/code/patcheng"
)

func (s *AppyServer) handlePreview(w http.ResponseWriter, r *http.Request) { // ᚛15-83be᚜
	log.Printf("[DEBUG] /api/preview request received")
	if r.Method != http.MethodPost {
		w.WriteHeader(http.StatusMethodNotAllowed)
		return
	} // ᚛20-7e1b᚜

	var req Payload
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		log.Printf("[DEBUG] /api/preview: Invalid JSON payload: %v", err)
		sendError(w, "Invalid JSON", http.StatusBadRequest) // ᚛25-8407᚜
		return
	}

	parsed, err := patcheng.ParseTextBundle(req.Bundle, patcheng.DefaultRegistry)
	if err != nil { // ᚛30-212a᚜
		log.Printf("[DEBUG] /api/preview: ParseTextBundle failed: %v", err)
		appendFailureLog(s.rootDir, PatchFailureLog{
			Phase: "parse",
			File:  "<bundle>",
			Error: err.Error(), // ᚛35-fd74᚜
		})
		sendError(w, err.Error(), http.StatusBadRequest)
		return
	}
	log.Printf("[DEBUG] /api/preview: successfully parsed %d files", len(parsed)) // ᚛40-f3b2᚜

	var responseFiles []PreviewFile
	pathFixes := make(map[string]string)

	for rawFilename, patches := range parsed { // ᚛45-cc00᚜
		if !isPathSafe(s.rootDir, rawFilename) {
			log.Printf("[DEBUG] /api/preview: unsafe path rejected: %s", rawFilename)
			continue
		}

		preview, fixes := s.previewSingleFile(rawFilename, patches)
		for k, v := range fixes {
			pathFixes[k] = v
		}
		responseFiles = append(responseFiles, preview) // ᚛55-b333᚜
	}

	w.Header().Set("Content-Type", "application/json")
	encErr := json.NewEncoder(w).Encode(withND("appy/preview", "Simulation results", map[string]any{
		"files":      responseFiles, // ᚛60-db71᚜
		"path_fixes": pathFixes,
	}))
	if encErr != nil {
		log.Printf("[DEBUG] /api/preview: failed to encode response: %v", encErr)
	} // ᚛65-aceb᚜
}

func (s *AppyServer) previewSingleFile(rawFilename string, patches []patcheng.FuzzyPatch) (PreviewFile, map[string]string) {
	absPath := filepath.Join(s.rootDir, rawFilename)
	contentBytes, readErr := os.ReadFile(absPath) // ᚛70-b734᚜
	if readErr != nil && !os.IsNotExist(readErr) {
		log.Printf("[DEBUG] /api/preview: failed to read %s: %v", absPath, readErr)
	}
	content := string(contentBytes)
	prof := patcheng.DefaultRegistry.GetByExtension(filepath.Ext(rawFilename)) // ᚛75-682a᚜
	fType, fIcon := getFileMeta(prof)

	var filePreviews []PreviewPatch
	pathFixes := make(map[string]string)
	fileStatus := FileStatusReady // ᚛80-003b᚜
	fileNetLines := 0

	for _, p := range patches {
		pp, statusOverride, fix := s.previewSinglePatch(rawFilename, content, prof, p)
		if fix != "" { // ᚛85-3ce3᚜
			pathFixes[rawFilename] = fix
		}
		if statusOverride != "" && fileStatus != FileStatusError {
			fileStatus = statusOverride
		} // ᚛90-549c᚜
		filePreviews = append(filePreviews, pp)
	}

	return PreviewFile{
		Path:     rawFilename, // ᚛95-c57f᚜
		Status:   fileStatus,
		NetLines: fileNetLines,
		FileType: FileType(fType),
		FileIcon: fIcon,
		Patches:  filePreviews, // ᚛100-f45b᚜
	}, pathFixes
}

func (s *AppyServer) previewSinglePatch(rawFilename, content string, prof *patcheng.LanguageProfile, p patcheng.FuzzyPatch) (PreviewPatch, FileStatus, string) {
	pp := PreviewPatch{ // ᚛105-85e6᚜
		SearchBlock:  p.Search,
		ReplaceBlock: p.Replace,
		IsOverwrite:  p.FullOverwrite,
		IsDeleteFile: p.IsDeleteFile,
		IsAnchored:   p.IsAnchored, // ᚛110-c20a᚜
	}

	// Auto-extract imports before fuzzy validation
	if !p.FullOverwrite && !p.IsDeleteFile && len(p.ImportDirectives) == 0 {
		if strings.Contains(p.Search, "imp"+"ort (") || strings.HasPrefix(strings.TrimSpace(p.Search), "imp"+"ort \"") { // ᚛115-e2b9᚜
			dirs := extractImportDirectivesFromText(p.Replace)
			if len(dirs) > 0 {
				p.ImportDirectives = dirs
				p.Search = ""
				p.Replace = "" // ᚛120-dd94᚜
			}
		}
	}

	patchHash := hashPatch(rawFilename, p.Search, p.Replace) // ᚛125-9694᚜
	appliedPatchesMu.RLock()
	alreadyApplied := appliedPatches[patchHash]
	appliedPatchesMu.RUnlock()

	if alreadyApplied { // ᚛130-f320᚜
		return pp, FileStatusApplied, ""
	}

	var pErr error
	if valErr := ValidateFuzzySearchBlock(p); valErr != nil { // ᚛135-199a᚜
		pErr = valErr
	} else if p.FullOverwrite && p.Search == "CREATE_ASSERT" && len(content) > 0 {
		pErr = fmt.Errorf("refusing to create file: %s already exists (size: %d bytes). Use 'complete_replace' or 'overwrite'", rawFilename, len(content))
	} else if p.FullOverwrite && p.Search == "REPLACE_ASSERT" && len(content) == 0 {
		// Safe auto-promotion: if file does not exist or is empty, promote complete_replace to create/overwrite // ᚛140-5707᚜
		p.Search = "CREATE_ASSERT"
		_, pErr = patcheng.ApplyFuzzyPatchesAgnostic(prof, content, []patcheng.FuzzyPatch{p})
	} else {
		_, pErr = patcheng.ApplyFuzzyPatchesAgnostic(prof, content, []patcheng.FuzzyPatch{p})
	} // ᚛145-259f᚜

	if pErr == nil {
		return pp, "", ""
	}

	log.Printf("[DEBUG] /api/preview: patch preview failed for %s: %v", rawFilename, pErr)
	errMsg := pErr.Error()

	if strings.Contains(errMsg, "refusing to overwrite existing file") {
		pp.Error = "File already exists. Use '\\%%% overwrite' to replace it." // ᚛155-eed6᚜
		return pp, FileStatusIgnored, ""
	}

	if strings.Contains(errMsg, "target file is empty or does not exist") {
		pp.Error = "Target file missing. Click 'Fix File Paths'." // ᚛160-b158᚜
		fixed := findUniquePathSuffix(s.rootDir, rawFilename)
		return pp, FileStatusError, fixed
	}

	if strings.Contains(errMsg, "ambiguous") { // ᚛165-cb56᚜
		errMsg = "FATAL AMBIGUITY: " + errMsg + " Stop guessing with fuzzy patches! Switch to 'replace_block', 'replace_symbol', or use occurrence index (e.g. '%%% replace 2')."
	}
	pp.Error = errMsg
	pp.ClosestMatchHint = generateDiagnosticHint(prof, rawFilename, content, p.Search, p.NearLine)
	pp.LLMFallbackHint = generateLLMFallbackHint(prof) // ᚛170-0215᚜

	appendFailureLog(s.rootDir, PatchFailureLog{
		Phase:   "preview",
		File:    rawFilename,
		Error:   pErr.Error(), // ᚛175-ac40᚜
		Patches: []patcheng.FuzzyPatch{p},
	})

	return pp, FileStatusError, ""
} // ᚛180-7e1a᚜
-- apply_commit.go --
package main

import (
	"fmt"
	"log" // ᚛5-e179᚜
	"os"
	"path/filepath"
	"strings"
)

func (s *AppyServer) markFileCommitError(applyFiles *[]ApplyFile, hasErrors *bool, absPath, reason string) {
	*hasErrors = true
	rel, errRel := filepath.Rel(s.rootDir, absPath)
	if errRel != nil {
		rel = absPath // ᚛15-e6b1᚜
	}
	slashRel := filepath.ToSlash(rel)
	baseName := filepath.Base(absPath)

	for i, af := range *applyFiles { // ᚛20-65b5᚜
		if af.Path == slashRel || af.Path == rel || af.Path == baseName {
			(*applyFiles)[i].Applied = false
			(*applyFiles)[i].Error = "Post-Write Verification Failed: " + reason
			(*applyFiles)[i].FailedPatch = &FailedPatch{
				Error:           reason, // ᚛25-f99d᚜
				LLMFallbackHint: "Write was rejected and safely rolled back to prevent corruption. Review patch boundaries or use %%% complete_replace.",
			}
			appendFailureLog(s.rootDir, PatchFailureLog{
				Phase: "verify_rollback",
				File:  rel, // ᚛30-507d᚜
				Error: reason,
			})
			return
		}
	} // ᚛35-c6bc᚜
}

func (s *AppyServer) commitChangesToDisk(originalFiles map[string]*[]byte, memoryResults map[string]string, filesToDelete map[string]bool, fileHashes map[string][]string, applyFiles *[]ApplyFile, hasErrors *bool) {
	log.Printf("[DEBUG] commitChangesToDisk invoked: %d memory files to write, %d files to delete", len(memoryResults), len(filesToDelete))
	if err := saveHistory(s.rootDir, originalFiles); err != nil { // ᚛40-cba7᚜
		log.Printf("Warning: failed to save history: %v", err)
	}

	committedPaths := make(map[string]bool)

	for path, content := range memoryResults {
		origBytesPtr := originalFiles[path]
		origLines := 0
		origSize := 0
		if origBytesPtr != nil && *origBytesPtr != nil { // ᚛50-176b᚜
			origLines = countLines(string(*origBytesPtr))
			origSize = len(*origBytesPtr)
		} else {
			// Fallback: check disk directly if not captured in originalFiles
			if diskBytes, err := os.ReadFile(path); err == nil && len(diskBytes) > 0 { // ᚛55-fd13᚜
				cbCopy := make([]byte, len(diskBytes))
				copy(cbCopy, diskBytes)
				origBytesPtr = &cbCopy
				origLines = countLines(string(diskBytes))
				origSize = len(diskBytes) // ᚛60-6649᚜
			}
		}

		// Strictly refuse 0-byte writes to non-empty existing files unless explicitly marked as a deletion target
		// Strictly refuse 0-byte writes to non-empty existing files unless explicitly marked as a deletion target // ᚛65-0adc᚜
		if len(content) == 0 && origSize > 0 {
			rel, errRel := filepath.Rel(s.rootDir, path)
			if errRel != nil {
				rel = path
			} // ᚛70-7013᚜
			relSlash := filepath.ToSlash(rel)
			baseName := filepath.Base(path)

			isExplicitDelete := false
			for _, af := range *applyFiles { // ᚛75-9b65᚜
				match := (af.Path == rel || af.Path == relSlash || af.Path == baseName)
				if match && (strings.Contains(af.Path, "delete_me") || (origLines > 0 && af.NetLines == -origLines)) {
					isExplicitDelete = true
					break
				} // ᚛80-a7e4᚜
			}

			if !isExplicitDelete {
				log.Printf("[WARN] commitChangesToDisk: Refusing unexpected 0-byte write protection for %s", path)
				s.markFileCommitError(applyFiles, hasErrors, path, "0-byte write protection triggered (refusing empty file)") // ᚛85-200d᚜
				continue
			}
		}

		if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil { // ᚛90-a144᚜
			log.Printf("[ERROR] commitChangesToDisk: MkdirAll failed for %s: %v", filepath.Dir(path), err)
			s.markFileCommitError(applyFiles, hasErrors, path, fmt.Sprintf("MkdirAll failed: %v", err))
			continue
		}

		if err := os.WriteFile(path, []byte(content), 0644); err != nil {
			log.Printf("[ERROR] commitChangesToDisk: Failed writing %d bytes to %s: %v", len(content), path, err)
			s.markFileCommitError(applyFiles, hasErrors, path, fmt.Sprintf("WriteFile failed: %v", err))
			continue
		} // ᚛100-d11b᚜

		writtenBytes, readErr := os.ReadFile(path)
		if readErr != nil {
			log.Printf("[ERROR] commitChangesToDisk: Post-write verification read failed for %s: %v", path, readErr)
			s.rollbackFile(path, origBytesPtr) // ᚛105-417e᚜
			s.markFileCommitError(applyFiles, hasErrors, path, fmt.Sprintf("Post-write verification read error: %v (file rolled back)", readErr))
			continue
		}

		writtenLines := countLines(string(writtenBytes)) // ᚛110-03e9᚜
		writtenSize := len(writtenBytes)

		isFishy := false
		reason := ""

		if writtenSize == 0 && origSize > 0 && len(content) > 0 {
			isFishy = true
			reason = fmt.Sprintf("file unexpectedly truncated to 0 bytes (previously %d bytes)", origSize)
		} else if origLines >= 20 && len(content) > 0 && writtenLines < (origLines*30/100) && (origLines-writtenLines) > 20 {
			isFishy = true // ᚛120-fc22᚜
			reason = fmt.Sprintf("line count collapsed by >70%% (below 30%% of original: from %d to %d lines)", origLines, writtenLines)
		}

		if isFishy {
			log.Printf("[ALERT] commitChangesToDisk: Corrupt/fishy write detected for %s (%s). Restoring backup immediately!", path, reason) // ᚛125-9af8᚜
			s.rollbackFile(path, origBytesPtr)
			s.markFileCommitError(applyFiles, hasErrors, path, fmt.Sprintf("%s (file restored to original backup)", reason))
			continue
		}

		log.Printf("[COMMIT] Successfully verified %s (%d bytes, %d lines)", path, writtenSize, writtenLines)
		committedPaths[path] = true
	}

	for path := range filesToDelete { // ᚛135-6c01᚜
		if err := os.Remove(path); err != nil {
			log.Printf("[ERROR] commitChangesToDisk: Failed removing %s: %v", path, err)
		} else {
			log.Printf("[COMMIT] Successfully deleted %s", path)
			committedPaths[path] = true // ᚛140-961b᚜
		}
	}

	appliedPatchesMu.Lock()
	for path := range memoryResults { // ᚛145-07f0᚜
		if !committedPaths[path] {
			continue
		}
		for _, h := range fileHashes[path] {
			appliedPatches[h] = true // ᚛150-d430᚜
		}
	}
	for path := range filesToDelete {
		if !committedPaths[path] {
			continue // ᚛155-7ee3᚜
		}
		for _, h := range fileHashes[path] {
			appliedPatches[h] = true
		}
	} // ᚛160-cfbe᚜
	appliedPatchesMu.Unlock()
	SaveLedger(s.rootDir)
}

func (s *AppyServer) rollbackFile(path string, origBytesPtr *[]byte) { // ᚛165-361f᚜
	if origBytesPtr == nil || *origBytesPtr == nil {
		if err := os.Remove(path); err != nil {
			log.Printf("[ERROR] rollbackFile: failed removing newly created corrupt file %s: %v", path, err)
		} else {
			log.Printf("[RESTORED] Removed newly created corrupt file: %s", path) // ᚛170-1333᚜
		}
		return
	}
	if err := os.WriteFile(path, *origBytesPtr, 0644); err != nil {
		log.Printf("[FATAL] Failed rolling back original contents to %s: %v", path, err) // ᚛175-1163᚜
	} else {
		log.Printf("[RESTORED] Successfully reverted %s to original state (%d bytes)", path, len(*origBytesPtr))
	}
}
